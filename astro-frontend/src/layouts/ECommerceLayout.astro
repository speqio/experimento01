---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/common/Header.tsx';
import GiftCardModal from '../components/giftcard/GiftCardModal.tsx';
import GiftCardRedeemModal from '../components/giftcard/GiftCardRedeemModal.tsx';
import Footer from '../components/common/Footer.astro';
import { kvCacheFrom } from '../lib/wp-graphql';
import { fetchLayoutData, type LayoutData } from '../lib/layoutData';
import Breadcrumbs from '../components/common/Breadcrumbs.astro';
import { breadcrumbSchema, type Crumb } from '../lib/seo';

interface Props {
  title: string;
  description?: string;
  /**
   * Opcional: si la página ya arrancó `fetchLayoutData(...)` al principio de
   * su propio frontmatter (sin await), la pasa acá para que corra en
   * paralelo con sus propias consultas en vez de arrancar recién ahora, ya
   * en serie con lo que la página tardó. Si no se pasa, el layout la pide él
   * mismo (páginas que aún no migraron a este patrón, o /nosotros /agenda
   * que son estáticas y no llaman a ECommerceLayout con SSR).
   */
  layoutData?: Promise<LayoutData>;
  image?: string | null;
  type?: 'website' | 'article' | 'product';
  noindex?: boolean;
  schema?: Record<string, unknown>[];
  /** Migas de pan sin "Inicio" (se agrega solo); también van al JSON-LD. */
  breadcrumbs?: Crumb[];
}
const { title, description, layoutData, breadcrumbs, schema = [], ...seo } = Astro.props;
const crumbs = breadcrumbs?.length ? [{ name: 'Inicio', path: '/' }, ...breadcrumbs] : null;
const allSchema = crumbs ? [...schema, breadcrumbSchema(Astro.url.origin, crumbs)] : schema;
const currentPath = Astro.url.pathname;

const { categoryGroups, giftCardImageUrl } = await (layoutData ?? fetchLayoutData(kvCacheFrom(Astro)));
---
<BaseLayout title={title} description={description} schema={allSchema} {...seo}>
  <Header currentPath={currentPath} categoryGroups={categoryGroups} client:idle />
  <main class="flex-grow">
    {crumbs && <Breadcrumbs crumbs={crumbs} />}
    <slot />
  </main>
  <Footer />
  <GiftCardModal cardImageUrl={giftCardImageUrl} client:idle />
  <GiftCardRedeemModal cardImageUrl={giftCardImageUrl} client:idle />
</BaseLayout>
