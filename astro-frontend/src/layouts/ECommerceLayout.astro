---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/common/Header.tsx';
import GiftCardModal from '../components/giftcard/GiftCardModal.tsx';
import Footer from '../components/common/Footer.astro';
import { kvCacheFrom } from '../lib/wp-graphql';
import { fetchLayoutData, type LayoutData } from '../lib/layoutData';

interface Props {
  title: string;
  description?: string;
  /**
   * Opcional: si la página ya arrancó `fetchLayoutData(...)` al principio de
   * su propio frontmatter (sin await), la pasa acá para que corra en
   * paralelo con sus propias consultas en vez de arrancar recién ahora, ya
   * en serie con lo que la página tardó. Si no se pasa, el layout la pide él
   * mismo (páginas que aún no migraron a este patrón, o /nosotros /agenda
   * que son estáticas y no llaman a ECommerceLayout con SSR).
   */
  layoutData?: Promise<LayoutData>;
}
const { title, description, layoutData } = Astro.props;
const currentPath = Astro.url.pathname;

const { categoryGroups, giftCardImageUrl } = await (layoutData ?? fetchLayoutData(kvCacheFrom(Astro)));
---
<BaseLayout title={title} description={description}>
  <Header currentPath={currentPath} categoryGroups={categoryGroups} client:idle />
  <main class="flex-grow">
    <slot />
  </main>
  <Footer />
  <GiftCardModal cardImageUrl={giftCardImageUrl} client:idle />
</BaseLayout>
