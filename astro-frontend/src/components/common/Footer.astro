---
import { SITE_INFO, RESERVO_URL } from '../../lib/siteInfo';

// Mismas secciones que el pie de spamandala.cl; las rutas son las páginas migradas (ver [...page].astro).
const tratamientos = [
  { href: '/tratamientos-faciales/', label: 'Tratamientos Faciales' },
  { href: '/tratamientos-corporales/', label: 'Tratamientos Corporales' },
  { href: '/masajes/', label: 'Masajes' },
  { href: '/spa-day/', label: 'Spa day' },
  { href: '/productos/', label: 'Productos' },
  { href: '/promociones', label: 'Promociones' },
  { href: '/convenios-empresas/', label: 'Convenios' },
  { href: '/eventos/', label: 'Eventos' },
  { href: '/blog', label: 'Blog Mandala' },
];
const whatsappUrl = `https://wa.me/${SITE_INFO.whatsapp}?text=${encodeURIComponent('Hola Mándala Spa, quisiera consultar por disponibilidades y servicios.')}`;
---
<footer id="site-footer" class="warm-footer">
  <div class="footer-main">
    <div class="footer-invitation">
      <a href="/" class="footer-brand" aria-label={`${SITE_INFO.name}, inicio`}>
        <img src="/images/servicios/logo-mandala-blanco.webp" alt={SITE_INFO.name} width="360" height="121" loading="lazy" decoding="async" class="footer-logo-img" />
      </a>
      <h2 class="font-editorial">Tu refugio urbano para el bienestar consciente.</h2>
      <a href={RESERVO_URL} target="_blank" rel="noopener" class="footer-reserve">
        Agenda tu hora
        <svg aria-hidden="true" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7M7 7h10v10" /></svg>
      </a>
      <p class="footer-location">{SITE_INFO.address}</p>
    </div>

    <div class="footer-directory">
      <section aria-labelledby="footer-contact">
        <h2 id="footer-contact">Encuéntranos</h2>
        <address>
          <a href="https://www.google.com/maps/search/?api=1&query=Presidente+Err%C3%A1zuriz+2933+Las+Condes" target="_blank" rel="noopener" class="footer-address">{SITE_INFO.streetAddress}<br />{SITE_INFO.address}</a>
          <a href={`tel:${SITE_INFO.phone.replace(/\s/g, '')}`}>{SITE_INFO.phone}</a>
          <a href={`mailto:${SITE_INFO.email}`}>{SITE_INFO.email}</a>
        </address>
      </section>
      <div class="footer-columns">
        <nav aria-labelledby="footer-explore">
          <h2 id="footer-explore">Explora</h2>
          <ul>{tratamientos.map((t) => <li><a href={t.href}>{t.label}</a></li>)}<li><a href="/sobre-nosotras">Sobre nosotras</a></li></ul>
        </nav>
        <section aria-labelledby="footer-hours">
          <h2 id="footer-hours">Horario de atención</h2>
          <dl>
            {SITE_INFO.hours.map((h) => (
              <div><dt>{h.label}</dt><dd>{h.opens} — {h.closes} hrs</dd></div>
            ))}
          </dl>
          <a href={whatsappUrl} target="_blank" rel="noopener" class="footer-whatsapp">Escríbenos por WhatsApp</a>
        </section>
      </div>
      <nav aria-label="Redes sociales y partner" class="footer-social">
        <a href={SITE_INFO.instagram} target="_blank" rel="noopener">Instagram</a>
        <a href={SITE_INFO.youtube} target="_blank" rel="noopener">YouTube</a>
        <a href={SITE_INFO.bigbox} target="_blank" rel="noopener">Partner Bigbox</a>
      </nav>
    </div>
  </div>

  <div class="footer-bottom">
    <p>&copy; {new Date().getFullYear()} {SITE_INFO.legalName}.</p>
    <nav aria-label="Información legal" class="footer-legal">
      <a href="/contacto/">Contacto</a>
      <a href="/politicas-de-la-empresa">Políticas de la empresa</a>
      <a href="/politicas-de-privacidad">Políticas de privacidad</a>
      <button type="button" data-cookie-prefs>Preferencias de cookies</button>
    </nav>
  </div>
</footer>

<style>
  .warm-footer { --footer-bg: #f4f1ea; --footer-ink: #302a26; --footer-muted: #675647; --footer-line: #d4c9bc; background: var(--footer-bg); color: var(--footer-ink); border-top: 1px solid var(--footer-line); }
  .footer-main { display: grid; grid-template-columns: minmax(0, 1fr); }
  .footer-invitation { display: flex; flex-direction: column; align-items: flex-start; gap: 2rem; background: #675647; color: #fff8ee; padding: 3rem 1.5rem; }
  .footer-brand { display: inline-block; line-height: 0; }
  .footer-logo-img { display: block; width: 160px; height: auto; max-width: 100%; }
  .footer-invitation h2 { max-width: 17ch; font-size: clamp(2.5rem, 3.5vw, 3.75rem); font-weight: 400; line-height: 1.08; letter-spacing: -.02em; text-wrap: balance; }
  .footer-reserve { display: inline-flex; align-items: center; justify-content: space-between; gap: 1.75rem; padding: .9rem 1.4rem; border: 1px solid #c8b7a5; border-radius: 999px; font-size: .875rem; transition: background-color .2s, color .2s; }
  .footer-reserve:hover { background: #fff8ee; color: #675647; }
  .footer-location { font-size: .8125rem; line-height: 1.7; color: #f0e6da; margin-top: auto; padding-top: .5rem; }
  .footer-directory { display: flex; flex-direction: column; gap: 2.25rem; padding: 3rem 1.5rem; min-width: 0; }
  .footer-directory h2 { font-size: .875rem; line-height: 1.5; font-weight: 600; margin-bottom: 1rem; }
  .footer-directory address { display: flex; flex-direction: column; align-items: flex-start; gap: .4rem; font-style: normal; font-size: .875rem; line-height: 1.75; }
  .footer-address { margin-bottom: .5rem; color: var(--footer-muted); }
  .footer-columns { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 1.5rem; }
  .footer-columns ul { display: grid; gap: .4rem; font-size: .8125rem; line-height: 1.7; color: var(--footer-muted); }
  .footer-columns dl { display: grid; gap: 1rem; font-size: .8125rem; line-height: 1.7; }
  .footer-columns dd { color: var(--footer-muted); }
  .footer-whatsapp { display: inline-block; margin-top: 1.5rem; font-size: .8125rem; text-decoration: underline; text-underline-offset: 4px; }
  .footer-social { display: flex; flex-wrap: wrap; gap: .75rem 1.75rem; padding-top: 1.25rem; border-top: 1px solid var(--footer-line); font-size: .8125rem; margin-top: auto; }
  .footer-bottom { max-width: 80rem; margin-inline: auto; padding: 1.5rem; display: flex; flex-direction: column; gap: 1rem; font-size: .6875rem; line-height: 1.8; color: var(--footer-muted); }
  .footer-legal { display: flex; flex-wrap: wrap; gap: .5rem 1.25rem; }
  .footer-legal button { text-align: left; }
  .warm-footer a, .warm-footer button { text-underline-offset: 4px; overflow-wrap: anywhere; }
  .warm-footer a:hover:not(.footer-reserve):not(.footer-brand), .footer-legal button:hover { text-decoration: underline; }
  .warm-footer :is(a, button):focus-visible { outline: 2px solid currentColor; outline-offset: 5px; border-radius: 2px; }
  @media (min-width: 640px) {
    .footer-invitation, .footer-directory { padding: 3.5rem 2.5rem; }
    .footer-columns { gap: 2.5rem; }
    .footer-bottom { padding: 1.5rem 2.5rem; }
  }
  @media (min-width: 900px) {
    .footer-main { grid-template-columns: minmax(0, 1fr) minmax(0, 1.35fr); }
    .footer-invitation { padding: 4rem 3rem 3rem max(2.5rem, calc((100vw - 72rem) / 2 + 2rem)); }
    .footer-directory { padding: 4rem max(2.5rem, calc((100vw - 72rem) / 2 + 2rem)) 3rem 3rem; }
    .footer-bottom { flex-direction: row; flex-wrap: wrap; justify-content: space-between; gap: .75rem 2rem; }
  }
  @media (any-pointer: coarse) {
    .footer-columns a, .footer-social a, .footer-legal :is(a, button), .footer-directory address a:not(.footer-address) { display: inline-flex; align-items: center; min-height: 44px; }
    .footer-brand { display: inline-flex; align-items: center; min-height: 44px; }
    .footer-social { gap: .5rem 1.5rem; }
    .footer-legal { gap: .25rem 1.25rem; }
    .footer-columns ul { gap: .125rem; }
  }
  @media (prefers-reduced-motion: reduce) { .footer-reserve { transition: none; } }
</style>
