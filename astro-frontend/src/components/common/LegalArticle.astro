---
// Envoltorio común de las páginas de políticas: encabezado, índice y tipografía del texto.
import ECommerceLayout from '../../layouts/ECommerceLayout.astro';

interface Props {
  title: string;
  description: string;
  updated: string;
  sections: { id: string; title: string }[];
}
const { title, description, updated, sections } = Astro.props;
---
<ECommerceLayout title={title} description={description}>
  <div class="bg-spa-sand py-14 sm:py-16 px-4 sm:px-6 lg:px-8 text-center">
    <span class="text-xs font-semibold tracking-[0.2em] text-spa-taupe uppercase block mb-3">Información importante</span>
    <h1 class="font-editorial text-3xl sm:text-5xl font-light text-spa-charcoal">{title}</h1>
    <p class="text-xs text-spa-taupe mt-4">Última actualización: {updated}</p>
  </div>

  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16 grid lg:grid-cols-[220px_minmax(0,1fr)] gap-10">
    <nav aria-label="Índice" class="hidden lg:block">
      <div class="sticky top-28">
        <p class="text-[11px] font-semibold tracking-[0.2em] text-spa-taupe uppercase mb-3">Contenido</p>
        <ol class="space-y-2 text-sm">
          {sections.map((s) => (
            <li><a href={`#${s.id}`} class="text-spa-taupe-dark hover:text-spa-charcoal transition-colors">{s.title}</a></li>
          ))}
        </ol>
      </div>
    </nav>
    <article class="legal min-w-0">
      <slot />
    </article>
  </div>
</ECommerceLayout>

<style is:global>
  .legal { color: #5C4F45; line-height: 1.75; font-size: 0.975rem; }
  .legal > p:first-child { font-size: 1.1rem; color: #2C2724; }
  .legal h2 {
    font-family: var(--font-editorial, Georgia, serif);
    font-size: 1.5rem; color: #2C2724; font-weight: 400;
    margin: 2.75rem 0 0.9rem; scroll-margin-top: 7rem;
    padding-top: 1.5rem; border-top: 1px solid #E8E2D7;
  }
  .legal h3 { font-weight: 600; color: #2C2724; margin: 1.4rem 0 0.4rem; font-size: 1rem; }
  .legal p { margin: 0 0 1rem; }
  .legal ul { list-style: disc; padding-left: 1.25rem; margin: 0 0 1rem; }
  .legal li { margin: 0.35rem 0; }
  .legal strong { color: #2C2724; }
  .legal a { color: #2C2724; text-decoration: underline; text-underline-offset: 3px; }
  .legal .nota { background: #F8F6F0; border: 1px solid #E8E2D7; border-radius: 12px; padding: 1rem 1.25rem; }
  .legal table { width: 100%; border-collapse: collapse; margin: 0 0 1rem; font-size: 0.925rem; }
  .legal th, .legal td { text-align: left; padding: 0.55rem 0.75rem; border-bottom: 1px solid #E8E2D7; }
  .legal th { color: #2C2724; font-weight: 600; }
</style>
