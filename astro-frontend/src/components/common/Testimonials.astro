---
import testimonials from '../../data/testimonials.json';
const initials = (name: string) => name.split(/\s+/).slice(0, 2).map((part) => part[0]).join('');
---
<section class="testimonials max-w-7xl mx-auto px-4 sm:px-6 lg:px-8" data-testimonials aria-labelledby="testimonials-title">
  <div class="testimonials-heading">
    <div>
      <h2 id="testimonials-title" class="font-editorial">Lo que cuentan nuestros clientes</h2>
      <p>Una selección de experiencias compartidas por nuestros clientes.</p>
    </div>
    <span class="testimonials-total">{testimonials.length} opiniones</span>
  </div>
  <div id="testimonials-track" class="testimonials-track carousel-fade" data-testimonials-track tabindex="0" role="region" aria-roledescription="carrusel" aria-label="Testimonios de clientes">
    {testimonials.map((review, index) => (
      <article class="testimonial" aria-label={`Opinión ${index + 1} de ${testimonials.length}`}>
        <svg class="testimonial-quote-icon" viewBox="0 0 32 24" width="32" height="24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round" aria-hidden="true"><path d="M13 2H3v10h5c0 4-2 7-5 9v1c7-2 10-7 10-14V2Zm16 0H19v10h5c0 4-2 7-5 9v1c7-2 10-7 10-14V2Z" /></svg>
        <blockquote id={`testimonial-quote-${index}`}><p>{review.text}</p></blockquote>
        {review.text.length > 180 && <button type="button" class="testimonial-expand" data-review-expand aria-expanded="false" aria-controls={`testimonial-quote-${index}`} hidden>Leer opinión completa</button>}
        <footer>
          <span class="testimonial-initials" aria-hidden="true">{initials(review.name)}</span>
          <span class="testimonial-author">{review.name}</span>
        </footer>
      </article>
    ))}
  </div>
  <div class="testimonials-controls" data-testimonials-controls hidden>
    <span class="sr-only" data-testimonials-position aria-live="polite" aria-atomic="true"></span>
    <div class="carousel-dots" data-carousel-dots></div>
    <div class="testimonials-arrows">
      <button type="button" data-testimonials-prev aria-label="Ver opiniones anteriores" aria-controls="testimonials-track" disabled>
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5m6-6-6 6 6 6" /></svg>
      </button>
      <button type="button" data-testimonials-next aria-label="Ver más opiniones" aria-controls="testimonials-track">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6" /></svg>
      </button>
    </div>
  </div>
</section>

<style>
  .testimonials-heading { display: flex; align-items: flex-end; justify-content: space-between; gap: 16px; margin-bottom: 28px; }
  .testimonials-heading h2 { max-width: 24ch; color: #2C2724; font-size: clamp(2rem, 3.4vw, 2.75rem); font-weight: 400; line-height: 1.12; letter-spacing: -.02em; text-wrap: balance; }
  .testimonials-heading p { margin-top: 12px; max-width: 48ch; color: #675647; font-size: 14px; line-height: 1.7; }
  .testimonials-total { flex-shrink: 0; padding-bottom: 3px; color: #675647; font-size: 13px; white-space: nowrap; }
  .testimonials-track { display: grid; grid-auto-flow: column; grid-auto-columns: 87%; align-items: stretch; gap: 16px; overflow-x: auto; scroll-snap-type: x mandatory; overscroll-behavior-x: contain; padding: 4px 2px 16px; scroll-padding-inline: 2px; }
  .testimonial { display: flex; flex-direction: column; min-width: 0; padding: 24px; border: 1px solid #E2D8CB; border-radius: 16px; background: #FDFBF7; scroll-snap-align: start; }
  .testimonial-quote-icon { flex-shrink: 0; color: #9A806A; margin-bottom: 20px; }
  .testimonial blockquote { color: #4A3E34; font-size: 15px; line-height: 1.8; overflow-wrap: anywhere; }
  [data-enhanced] .testimonial:not([data-expanded]) blockquote p { display: -webkit-box; -webkit-line-clamp: 5; -webkit-box-orient: vertical; overflow: hidden; }
  .testimonial footer { display: flex; align-items: center; gap: 12px; margin-top: auto; padding-top: 24px; }
  .testimonial-initials { display: flex; align-items: center; justify-content: center; flex-shrink: 0; width: 40px; height: 40px; border-radius: 50%; background: #EEE7DD; color: #675647; font-family: 'Cormorant Garamond', Georgia, serif; font-size: 19px; font-weight: 600; }
  .testimonial-author { color: #3D3530; font-size: 13px; font-weight: 600; }
  .testimonial-expand { align-self: flex-start; min-height: 44px; color: #675647; font-size: 13px; text-decoration: underline; text-underline-offset: 4px; }
  .testimonial-expand[hidden] { display: none; }
  .testimonials-controls:not([hidden]) { display: flex; align-items: center; justify-content: space-between; gap: 16px; margin-top: 12px; }
  .testimonials-position { color: #675647; font-size: 13px; font-variant-numeric: tabular-nums; }
  .testimonials-arrows { display: flex; gap: 10px; }
  .testimonials-arrows button { display: flex; align-items: center; justify-content: center; width: 48px; height: 48px; border: 1px solid #C7B8A7; border-radius: 50%; color: #3D3530; }
  .testimonials-arrows button:disabled { opacity: .35; }
  .testimonials-arrows button:hover:not(:disabled), .testimonials-arrows button:active:not(:disabled) { background: #EEE7DD; }
  .testimonials :is(button, [tabindex]):focus-visible { outline: 2px solid #675647; outline-offset: 2px; }
  @media (max-width: 639px) { .testimonials-heading { align-items: flex-start; flex-direction: column; gap: 12px; margin-bottom: 20px; } .testimonial { padding: 22px; } }
  @media (min-width: 640px) { .testimonials-track { grid-auto-columns: calc((100% - 24px) / 2); gap: 24px; } }
  @media (min-width: 1024px) { .testimonials-track { grid-auto-columns: calc((100% - 48px) / 3.15); } .testimonial { padding: 28px; } }
</style>

<script>
  import { paginate, syncFade } from '../../lib/carouselDots';
  const section = document.querySelector<HTMLElement>('[data-testimonials]');
  if (section) {
    const track = section.querySelector<HTMLElement>('[data-testimonials-track]')!;
    const cards = Array.from(track.querySelectorAll<HTMLElement>('.testimonial'));
    const previous = section.querySelector<HTMLButtonElement>('[data-testimonials-prev]')!;
    const next = section.querySelector<HTMLButtonElement>('[data-testimonials-next]')!;
    const position = section.querySelector<HTMLElement>('[data-testimonials-position]')!;
    const dots = section.querySelector<HTMLElement>('[data-carousel-dots]')!;
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    section.dataset.enhanced = '';
    section.querySelector<HTMLElement>('[data-testimonials-controls]')!.hidden = cards.length < 2;
    let current = 0;
    let frame = 0;
    const offset = (card: HTMLElement) => card.getBoundingClientRect().left - track.getBoundingClientRect().left + track.scrollLeft - 2;
    const update = () => {
      current = cards.reduce((nearest, card, index) => Math.abs(offset(card) - track.scrollLeft) < Math.abs(offset(cards[nearest]) - track.scrollLeft) ? index : nearest, 0);
      const fullyVisible = cards.filter((card) => offset(card) >= track.scrollLeft - 3 && offset(card) + card.offsetWidth <= track.scrollLeft + track.clientWidth + 3);
      const last = fullyVisible.length ? cards.indexOf(fullyVisible[fullyVisible.length - 1]) : current;
      const label = current === last ? `${current + 1} de ${cards.length}` : `${current + 1}–${last + 1} de ${cards.length}`;
      if (position.textContent !== label) position.textContent = label;
      paginate(dots, cards.length, current, goTo);
      syncFade(track);
      previous.disabled = track.scrollLeft <= 2;
      next.disabled = track.scrollLeft >= track.scrollWidth - track.clientWidth - 2;
      cards.forEach((card) => {
        const button = card.querySelector<HTMLButtonElement>('[data-review-expand]');
        if (!button) return;
        const quote = card.querySelector('blockquote p') as HTMLElement;
        button.hidden = !card.hasAttribute('data-expanded') && quote.scrollHeight <= quote.clientHeight + 1;
      });
    };
    const goTo = (index: number) => track.scrollTo({ left: offset(cards[Math.max(0, Math.min(cards.length - 1, index))]), behavior: reducedMotion.matches ? 'instant' : 'smooth' });
    previous.addEventListener('click', () => goTo(current - 1));
    next.addEventListener('click', () => goTo(current + 1));
    track.addEventListener('scroll', () => { cancelAnimationFrame(frame); frame = requestAnimationFrame(update); }, { passive: true });
    track.addEventListener('keydown', (event) => {
      if (event.target !== track) return;
      if (!['ArrowRight', 'ArrowLeft', 'Home', 'End'].includes(event.key)) return;
      event.preventDefault();
      goTo(event.key === 'Home' ? 0 : event.key === 'End' ? cards.length - 1 : current + (event.key === 'ArrowRight' ? 1 : -1));
    });
    section.querySelectorAll<HTMLButtonElement>('[data-review-expand]').forEach((button) => {
      button.addEventListener('click', () => {
        const card = button.closest<HTMLElement>('.testimonial')!;
        const expanded = card.toggleAttribute('data-expanded');
        button.setAttribute('aria-expanded', String(expanded));
        button.textContent = expanded ? 'Leer menos' : 'Leer opinión completa';
        update();
      });
    });
    new ResizeObserver(update).observe(track);
    document.fonts.ready.then(update);
    update();
  }
</script>
