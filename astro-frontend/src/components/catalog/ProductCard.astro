---
import type { SimpleProduct } from '../../types/catalog';
import { getProductDuration, getProductBadge, extractDuration, getCardSummary, getPriceDisplay, hasAnyDiscount } from '../../lib/parse';

interface Props {
  product: Pick<
    SimpleProduct,
    'databaseId' | 'name' | 'slug' | 'price' | 'regularPrice' | 'image' | 'shortDescription' | 'attributes' | 'giftCardEnabled'
  >;
  href: string;
}
const { product, href } = Astro.props;

const { duration: descDuration } = extractDuration(product.shortDescription ?? '');
const summary = getCardSummary(product.shortDescription ?? '');
const priceInfo = getPriceDisplay(product.price, product.regularPrice);
const duration = getProductDuration(product.attributes) ?? descDuration;
const badge = getProductBadge(product.name);
// Con variantes, el "Desde" puede no tener descuento aunque otra opción sí: la etiqueta lo avisa sin tachar un precio falso.
const onSale = hasAnyDiscount(product.price, product.regularPrice);
---
<article class="product-card">
  <!-- Foto -->
  <a href={href} class="product-card__photo" aria-label={product.name}>
    {product.image?.sourceUrl ? (
      <img src={product.image.sourceUrl} alt={product.image.altText || product.name} width="600" height="450" loading="lazy" decoding="async" class="product-card__image" />
    ) : (
      <div class="product-card__image-placeholder" />
    )}

    <!-- Gradiente inferior para legibilidad -->
    <div class="product-card__gradient" aria-hidden="true" />

    <!-- Duración sobre la foto, esquina inferior izquierda -->
    {duration && (
      <div class="product-card__duration">
        <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 3" />
        </svg>
        <span>{duration}</span>
      </div>
    )}

    <!-- Badge (Nuevo / Bestseller…) -->
    {badge && (
      <span class="product-card__badge">{badge}</span>
    )}

    <!-- Descuento -->
    {onSale && (
      <span class="product-card__sale-icon" aria-label="Con descuento">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78L12 21.23l8.84-8.84a5.5 5.5 0 0 0 0-7.78Z" />
        </svg>
      </span>
    )}
  </a>

  <!-- Cuerpo de la card -->
  <div class="product-card__body">
    <h3 class="product-card__title">
      <a href={href}>{product.name}</a>
    </h3>

    {summary && (
      <p class="product-card__summary">{summary}</p>
    )}

    <div class="product-card__footer">
      <!-- Precio -->
      <div class="product-card__price">
        {priceInfo.original && (
          <s class="product-card__price-original">{priceInfo.original}</s>
        )}
        <span class="product-card__price-current">{priceInfo.current}</span>
      </div>

      <!-- CTAs -->
      {product.__typename === 'VariableProduct' ? (
        <a href={href} class="product-card__cta product-card__cta--primary">
          Elegir opciones
        </a>
      ) : (
        <div class={`product-card__ctas ${product.giftCardEnabled === false ? 'product-card__ctas--single' : ''}`}>
          <button type="button" data-add-to-cart={product.databaseId} class="product-card__cta product-card__cta--secondary">
            Agregar al carrito
          </button>
          {product.giftCardEnabled !== false && (
            <button
              type="button"
              data-gift-product={product.databaseId}
              data-gift-name={product.name}
              data-gift-image={product.image?.sourceUrl}
              class="product-card__cta product-card__cta--primary"
            >
              Regalar
            </button>
          )}
        </div>
      )}
    </div>
  </div>
</article>

<style>
  /* ── Estructura ─────────────────────────────────────────── */
  .product-card {
    display: flex;
    flex-direction: column;
    background: #fff;
    border-radius: 1.25rem;
    border: 1px solid #E8E2D7;
    overflow: hidden;
    box-shadow: 0 1px 4px rgb(0 0 0 / .05);
    transition: box-shadow .3s ease, transform .3s ease;
  }
  .product-card:is(:hover, :focus-within) {
    box-shadow: 0 8px 32px rgb(103 86 71 / .12);
    transform: translateY(-3px);
  }

  /* ── Foto ──────────────────────────────────────────────── */
  .product-card__photo {
    position: relative;
    display: block;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: #F0EBE3;
  }
  .product-card__image {
    position: absolute; inset: 0;
    width: 100%; height: 100%;
    object-fit: cover;
    transition: transform .7s cubic-bezier(.16, 1, .3, 1);
  }
  .product-card__image-placeholder { position: absolute; inset: 0; background: #EDE7DC; }
  .product-card:is(:hover, :focus-within) .product-card__image { transform: scale(1.04); }

  /* Gradiente sutil */
  .product-card__gradient {
    position: absolute; inset: 0;
    background: linear-gradient(to top, rgb(44 39 36 / .45) 0%, transparent 55%);
    pointer-events: none;
  }

  /* ── Duración — pill elegante sobre la foto ─────────────── */
  .product-card__duration {
    position: absolute;
    bottom: .875rem;
    left: .875rem;
    display: inline-flex;
    align-items: center;
    gap: .35rem;
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 1rem;
    font-style: italic;
    font-weight: 500;
    letter-spacing: .01em;
    color: #fff;
    background: rgb(44 39 36 / .55);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    padding: .3rem .75rem .3rem .6rem;
    border-radius: 999px;
    border: 1px solid rgb(255 255 255 / .18);
    line-height: 1;
  }

  /* ── Badges ─────────────────────────────────────────────── */
  .product-card__badge {
    position: absolute;
    top: .75rem; right: .75rem;
    background: #2C2724;
    color: #fff;
    font-family: 'Manrope', sans-serif;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: .08em;
    text-transform: uppercase;
    padding: .3rem .7rem;
    border-radius: 999px;
  }
  .product-card__sale-icon {
    position: absolute;
    top: .75rem; left: .75rem;
    display: flex; align-items: center; justify-content: center;
    width: 2rem; height: 2rem;
    background: #fff;
    color: #9B6F5C;
    border-radius: 50%;
    box-shadow: 0 1px 4px rgb(0 0 0 / .1);
  }

  /* ── Cuerpo ─────────────────────────────────────────────── */
  .product-card__body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 1.25rem 1.25rem 1.125rem;
  }

  /* Título en Cormorant */
  .product-card__title {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 1.35rem;
    font-weight: 600;
    line-height: 1.25;
    color: #2C2724;
    margin-bottom: .5rem;
  }
  .product-card__title a {
    color: inherit;
    text-decoration: none;
    transition: color .2s;
  }
  .product-card__title a:hover { color: #675647; }

  /* Resumen */
  .product-card__summary {
    font-size: .8125rem;
    line-height: 1.65;
    color: #7A6557;
    margin-bottom: auto;
    padding-bottom: .875rem;
  }

  /* Footer: precio + botones */
  .product-card__footer {
    border-top: 1px solid #EFECE4;
    padding-top: .875rem;
    display: flex;
    flex-direction: column;
    gap: .75rem;
  }

  /* Precio */
  .product-card__price { display: flex; align-items: baseline; gap: .5rem; }
  .product-card__price-original {
    font-size: .8125rem;
    text-decoration: line-through;
    color: #A89080;
  }
  .product-card__price-current {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 1.5rem;
    font-weight: 700;
    color: #2C2724;
    line-height: 1;
  }

  /* Botones */
  .product-card__ctas { display: grid; grid-template-columns: 1fr 1fr; gap: .5rem; }
  .product-card__ctas--single { grid-template-columns: 1fr; }
  .product-card__cta {
    display: flex; align-items: center; justify-content: center;
    padding: .6rem .75rem;
    border-radius: 999px;
    font-family: 'Manrope', sans-serif;
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: .07em;
    text-transform: uppercase;
    text-decoration: none;
    cursor: pointer;
    border: none;
    transition: background .2s, color .2s;
    min-height: 38px;
  }
  .product-card__cta--primary { background: #675647; color: #fff; }
  .product-card__cta--primary:hover { background: #5A4A3C; }
  .product-card__cta--secondary { background: #EFECE4; color: #675647; }
  .product-card__cta--secondary:hover { background: #E5E0D5; }

  .product-card :is(a, button):focus-visible { outline: 2px solid #675647; outline-offset: -2px; }

  @media (any-pointer: coarse) {
    .product-card__cta { min-height: 44px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .product-card, .product-card__image { transition: none; }
    .product-card:is(:hover, :focus-within) { transform: none; }
    .product-card:is(:hover, :focus-within) .product-card__image { transform: none; }
  }
</style>