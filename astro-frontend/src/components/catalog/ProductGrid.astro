---
import ProductCard from './ProductCard.astro';
import type { SimpleProduct } from '../../types/catalog';

interface Props {
  products: Pick<SimpleProduct, 'name' | 'slug' | 'price' | 'image'>[];
  basePath: string;
}
const { products, basePath } = Astro.props;
---
<div class="grid grid-cols-2 md:grid-cols-4 gap-4">
  {products.map((product) => (
    <ProductCard product={product} href={`${basePath}/${product.slug}`} />
  ))}
</div>
