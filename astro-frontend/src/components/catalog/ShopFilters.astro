---
import type { SimpleProduct } from '../../types/catalog';
import { getProductBadge, getProductDuration, extractDuration, hasAnyDiscount } from '../../lib/parse';

interface Props {
  products: Pick<SimpleProduct, 'databaseId' | 'name' | 'price' | 'regularPrice' | 'shortDescription' | 'attributes' | 'productCategories'>[];
}
const { products } = Astro.props;

function durationToMinutes(str: string): number {
  const s = str.toLowerCase();
  let hours = 0, mins = 0;
  const hMatch = s.match(/(\d+(?:\.\d+)?)\s*hora/);
  if (hMatch) hours = parseFloat(hMatch[1]);
  if (/y\s*media/.test(s)) mins += 30;
  const mMatch = s.match(/(\d+)\s*min/);
  if (mMatch) mins += parseInt(mMatch[1]);
  if (s.includes('media hora') && !hMatch) return 30;
  return hours * 60 + mins;
}

function getDurationBucket(p: typeof products[0]): string | null {
  const { duration: descDur } = extractDuration(p.shortDescription ?? '');
  const durStr = getProductDuration(p.attributes) ?? descDur;
  if (!durStr) return null;
  const mins = durationToMinutes(durStr);
  if (mins <= 0) return null;
  if (mins <= 45) return 'short';
  if (mins <= 70) return 'medium';
  return 'long';
}

// Compute which filter groups are useful (have at least one product matching)
const showParaDos = products.some(p => getProductBadge(p.name) === 'Cabina Doble');
const showParaUno = products.some(p => getProductBadge(p.name) !== 'Cabina Doble');
const showAudienceFilter = showParaDos && showParaUno;

const durationBuckets = new Set(products.map(getDurationBucket).filter(Boolean));
const showDurationFilter = durationBuckets.size > 1;

const showDiscountFilter = products.some(p => hasAnyDiscount(p.price, p.regularPrice));

// Unique categories (sorted by frequency)
const catCount: Record<string, { name: string; count: number }> = {};
for (const p of products) {
  for (const cat of p.productCategories?.nodes ?? []) {
    if (!catCount[cat.slug]) catCount[cat.slug] = { name: cat.name, count: 0 };
    catCount[cat.slug].count++;
  }
}
const categories = Object.entries(catCount)
  .filter(([, v]) => v.count > 0)
  .sort((a, b) => b[1].count - a[1].count)
  .slice(0, 6)
  .map(([slug, v]) => ({ slug, name: v.name }));
const showCategoryFilter = categories.length > 1;

const hasAnyFilter = showAudienceFilter || showDurationFilter || showDiscountFilter || showCategoryFilter;
if (!hasAnyFilter) return;
---

<div id="shop-filters" class="mb-8 space-y-3" data-total={products.length}>
  <details id="filter-disclosure">
    <summary class="filter-toggle">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 17h16M9 4v6M15 14v6" /></svg>
      <span>Filtrar<span id="filter-active-count"></span></span>
      <svg class="filter-chevron" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
    </summary>
  <div class="filter-options flex flex-wrap gap-x-6 gap-y-3 items-start">

    {showAudienceFilter && (
      <details class="filter-group flex items-center gap-2 flex-wrap" data-group="audience">
        <summary class="filter-group-toggle"><span>Para</span><span class="filter-group-count"></span><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg></summary>
        <div class="filter-choices">
        <button class="filter-chip" data-value="solo">Solo</button>
        <button class="filter-chip" data-value="pareja">Pareja</button>
        </div>
      </details>
    )}

    {showDurationFilter && (
      <details class="filter-group flex items-center gap-2 flex-wrap" data-group="duration">
        <summary class="filter-group-toggle"><span>Duración</span><span class="filter-group-count"></span><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg></summary>
        <div class="filter-choices">
        {durationBuckets.has('short') && <button class="filter-chip" data-value="short">Hasta 45 min</button>}
        {durationBuckets.has('medium') && <button class="filter-chip" data-value="medium">46 a 70 min</button>}
        {durationBuckets.has('long') && <button class="filter-chip" data-value="long">Más de 70 min</button>}
        </div>
      </details>
    )}

    {showCategoryFilter && (
      <details class="filter-group flex items-center gap-2 flex-wrap" data-group="category">
        <summary class="filter-group-toggle"><span>Tipo</span><span class="filter-group-count"></span><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg></summary>
        <div class="filter-choices">
        {categories.map(cat => (
          <button class="filter-chip" data-value={cat.slug}>{cat.name}</button>
        ))}
        </div>
      </details>
    )}

    {showDiscountFilter && (
      <div class="filter-group flex items-center gap-2 flex-wrap" data-group="discount">
        <button class="filter-chip" data-value="true">
          <svg aria-hidden="true" viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="inline -mt-0.5 mr-0.5"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78L12 21.23l8.84-8.84a5.5 5.5 0 0 0 0-7.78Z" /></svg>
          Con descuento
        </button>
      </div>
    )}
  </div>
    <button type="button" id="filter-done" class="filter-done">Ver {products.length} productos</button>
  </details>

  <div id="filter-status" class="flex flex-wrap items-center justify-between gap-x-3 text-sm text-[#675647]">
    <span id="filter-count" role="status" aria-live="polite" aria-atomic="true">{products.length} productos</span>
    <button type="button" id="filter-clear" hidden class="underline underline-offset-4 decoration-spa-taupe/40 hover:text-spa-charcoal transition-colors">Limpiar filtros</button>
  </div>
  <p id="filter-empty" hidden class="rounded-xl bg-spa-sand px-4 py-5 text-sm text-spa-charcoal">No hay productos con esta combinación. Prueba otras opciones o limpia los filtros.</p>
</div>

<style>
  .filter-toggle { display: flex; align-items: center; gap: 10px; min-height: 48px; padding: 10px 16px; border: 1px solid #D8D0C5; border-radius: 12px; color: #3D3530; font-size: 14px; font-weight: 600; cursor: pointer; list-style: none; }
  .filter-toggle::-webkit-details-marker { display: none; }
  .filter-chevron { margin-left: auto; }
  details[open] .filter-chevron { transform: rotate(180deg); }
  .filter-done { display: none; }
  #filter-clear { min-height: 44px; }
  #filter-clear[hidden], #filter-empty[hidden] { display: none; }
  .filter-toggle:focus-visible, .filter-done:focus-visible, #filter-clear:focus-visible { outline: 2px solid #675647; outline-offset: 2px; }
  @media (max-width: 767px) {
    .filter-toggle { width: fit-content; }
    .filter-options { flex-direction: column; flex-wrap: nowrap; gap: 20px; max-height: 48vh; max-height: 48dvh; overflow-y: auto; overscroll-behavior: contain; padding: 16px 4px; }
    .filter-group { width: 100%; }
    .filter-group > span { width: 100%; font-size: 12px; letter-spacing: .04em; }
    .filter-options .filter-chip { min-height: 44px; padding: 10px 14px; font-size: 14px; letter-spacing: 0; text-align: left; }
    .filter-done { display: block; width: fit-content; max-width: 100%; min-height: 48px; padding: 12px 24px; border-radius: 999px; background: #3D3530; color: #fff; font-size: 14px; font-weight: 600; }
    #shop-filters { margin-bottom: 20px; }
  }
  @media (min-width: 768px) { .filter-toggle { display: none; } }
  @media (prefers-reduced-motion: reduce) { .filter-chip { transition: none; } }
  .filter-chip {
    display: inline-flex;
    align-items: center;
    padding: .35rem .85rem;
    border-radius: 9999px;
    border: 1.5px solid #D8D0C5;
    background: white;
    font-size: .75rem;
    font-weight: 600;
    color: #675647;
    letter-spacing: .04em;
    cursor: pointer;
    transition: background .15s, border-color .15s, color .15s;
    line-height: 1.4;
  }
  .filter-chip:hover {
    border-color: #675647;
    background: #F7F4EF;
  }
  .filter-chip.active {
    background: #3D3530;
    border-color: #3D3530;
    color: white;
  }
  .filter-chip:focus-visible {
    outline: 2px solid #675647;
    outline-offset: 2px;
  }
  .filter-group-toggle { display: flex; align-items: center; gap: 8px; min-height: 44px; list-style: none; cursor: pointer; color: #3D3530; font-size: 14px; font-weight: 500; }
  .filter-group-toggle::-webkit-details-marker { display: none; }
  .filter-group-toggle svg { margin-left: auto; flex-shrink: 0; }
  .filter-group[open] > summary svg { transform: rotate(180deg); }
  .filter-group-count:not(:empty) { display: inline-flex; align-items: center; justify-content: center; min-width: 20px; height: 20px; padding: 0 5px; border-radius: 50%; background: #3D3530; color: white; font-size: 11px; }
  .filter-group-toggle:focus-visible { outline: 2px solid #675647; outline-offset: 2px; }
  .filter-choices { display: flex; flex-wrap: wrap; gap: 8px; }
  @media (max-width: 767px) {
    details.filter-group { display: block; }
    .filter-group-toggle { padding: 0 4px; margin-bottom: 4px; }
  }
  @media (min-width: 768px) {
    .filter-options { align-items: center; gap: 10px; padding: 0 0 16px; border-bottom: 1px solid #E2DBD0; }
    details.filter-group { display: block; position: relative; }
    .filter-group-toggle { min-width: 132px; padding: 0 14px; border: 1px solid #D8D0C5; border-radius: 10px; background: #FAF8F5; }
    .filter-group-toggle:hover, .filter-group[open] > summary { background: #EEE7DD; border-color: #A18E7E; }
    .filter-choices { position: absolute; top: calc(100% + 8px); left: 0; z-index: 30; display: flex; flex-direction: column; flex-wrap: nowrap; gap: 4px; width: 270px; max-width: calc(100vw - 48px); max-height: 360px; overflow-y: auto; overscroll-behavior: contain; padding: 8px; border-radius: 12px; background: #FDFBF7; box-shadow: 0 10px 32px #26211d24; }
    .filter-choices .filter-chip { justify-content: flex-start; gap: 10px; min-height: 44px; width: 100%; padding: 10px; border: 0; border-radius: 6px; background: transparent; font-size: 14px; letter-spacing: 0; font-weight: 400; text-align: left; }
    .filter-choices .filter-chip::before { content: ''; width: 16px; height: 16px; flex-shrink: 0; border: 1px solid #A18E7E; border-radius: 4px; }
    .filter-choices .filter-chip.active { background: #EEE7DD; color: #3D3530; font-weight: 600; }
    .filter-choices .filter-chip.active::before { width: 8px; height: 13px; margin: 0 4px; border: solid #675647; border-width: 0 2px 2px 0; border-radius: 0; transform: rotate(45deg) translateY(-2px); }
    .filter-choices .filter-chip:hover { background: #EEE7DD; }
    [data-group="discount"] { margin-left: auto; }
    [data-group="discount"] .filter-chip { gap: 6px; min-height: 44px; padding: 10px 14px; border-width: 1px; border-radius: 10px; font-size: 14px; letter-spacing: 0; font-weight: 500; background: transparent; }
    [data-group="discount"] .filter-chip.active { background: #3D3530; }
    #filter-status { font-size: 13px; }
  }
</style>

<script>
  (() => {
    const filtersEl = document.getElementById('shop-filters');
    if (!filtersEl) return;

    // Build per-product filter data from each card's data-filters attribute
    const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-product-filters]'));
    if (!cards.length) return;

    // Active filters: { group: Set<value> }
    const active: Record<string, Set<string>> = {};
    const disclosure = document.getElementById('filter-disclosure') as HTMLDetailsElement;
    const done = document.getElementById('filter-done')!;
    const clear = document.getElementById('filter-clear')!;
    const desktop = window.matchMedia('(min-width: 768px)');
    const groupPanels = Array.from(filtersEl.querySelectorAll<HTMLDetailsElement>('details.filter-group'));
    const syncDisclosure = () => {
      disclosure.open = desktop.matches;
      groupPanels.forEach((panel) => { panel.open = !desktop.matches; });
    };
    desktop.addEventListener('change', syncDisclosure);
    syncDisclosure();
    groupPanels.forEach((panel) => {
      panel.addEventListener('toggle', () => {
        if (panel.open && desktop.matches) groupPanels.forEach((other) => { if (other !== panel) other.open = false; });
      });
    });
    document.addEventListener('pointerdown', (event) => {
      if (desktop.matches) groupPanels.forEach((panel) => { if (!panel.contains(event.target as Node)) panel.open = false; });
    });
    filtersEl.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape' || !desktop.matches) return;
      const panel = (event.target as Element).closest<HTMLDetailsElement>('details.filter-group');
      if (panel?.open) { event.preventDefault(); panel.open = false; panel.querySelector('summary')?.focus(); }
    });
    done.addEventListener('click', () => {
      disclosure.open = false;
      disclosure.querySelector('summary')?.focus();
    });

    function applyFilters() {
      const groups = Object.entries(active).filter(([, vals]) => vals.size > 0);
      let visible = 0;
      for (const card of cards) {
        const raw = card.dataset.productFilters ?? '{}';
        let data: Record<string, string | string[]>;
        try { data = JSON.parse(raw); } catch { data = {}; }

        const matches = groups.every(([group, vals]) => {
          const cardVal = data[group];
          if (!cardVal) return false;
          if (Array.isArray(cardVal)) return cardVal.some(v => vals.has(v));
          return vals.has(String(cardVal));
        });

        card.hidden = !matches;
        if (matches) visible++;
      }

      const countEl = document.getElementById('filter-count');
      const resultLabel = `${visible} ${visible === 1 ? 'producto' : 'productos'}`;
      if (countEl) countEl.textContent = resultLabel;
      done.textContent = `Ver ${resultLabel}`;
      clear.hidden = groups.length === 0;
      const selected = groups.reduce((total, [, values]) => total + values.size, 0);
      document.getElementById('filter-active-count')!.textContent = selected ? ` (${selected})` : '';
      document.getElementById('filter-empty')!.hidden = visible !== 0;
      groupPanels.forEach((panel) => {
        const count = active[panel.dataset.group!]?.size ?? 0;
        panel.querySelector('.filter-group-count')!.textContent = count ? String(count) : '';
      });
    }

    filtersEl.querySelectorAll<HTMLButtonElement>('.filter-chip').forEach(chip => {
      const group = chip.closest<HTMLElement>('[data-group]')?.dataset.group;
      if (!group) return;
      chip.type = 'button';
      chip.setAttribute('aria-pressed', 'false');
      chip.addEventListener('click', () => {
        if (!active[group]) active[group] = new Set();
        if (active[group].has(chip.dataset.value!)) {
          active[group].delete(chip.dataset.value!);
          chip.classList.remove('active');
          chip.setAttribute('aria-pressed', 'false');
        } else {
          active[group].add(chip.dataset.value!);
          chip.classList.add('active');
          chip.setAttribute('aria-pressed', 'true');
        }
        applyFilters();
      });
    });

    document.getElementById('filter-clear')?.addEventListener('click', () => {
      for (const key of Object.keys(active)) active[key].clear();
      filtersEl.querySelectorAll('.filter-chip.active').forEach(c => {
        c.classList.remove('active');
        c.setAttribute('aria-pressed', 'false');
      });
      applyFilters();
      if (desktop.matches) filtersEl.querySelector<HTMLElement>('.filter-group-toggle, [data-group="discount"] button')?.focus();
      else if (disclosure.open) filtersEl.querySelector<HTMLButtonElement>('.filter-chip')?.focus();
      else disclosure.querySelector('summary')?.focus();
    });
    applyFilters();
  })();
</script>
