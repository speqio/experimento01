<aside
  id="cart-notification"
  aria-label="Notificación del carrito"
  class="fixed top-24 right-4 left-4 sm:left-auto sm:right-6 sm:w-96 z-[110] rounded-2xl bg-spa-card text-spa-charcoal p-5 shadow-xl"
  hidden
>
  <div class="flex items-start gap-3">
    <svg aria-hidden="true" class="w-5 h-5 shrink-0 mt-0.5 text-spa-taupe" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="m5 12 4 4L19 6" />
    </svg>
    <div class="min-w-0 flex-1">
      <p data-cart-message role="status" aria-live="polite" aria-atomic="true" class="text-sm font-semibold"></p>
      <a href="/carrito" class="inline-block mt-2 text-sm text-spa-taupe underline underline-offset-4 hover:text-spa-charcoal focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4">Ver carrito</a>
    </div>
    <button type="button" data-cart-dismiss aria-label="Cerrar notificación" class="shrink-0 -m-2 p-2 rounded-lg hover:bg-spa-sand focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2">
      <svg aria-hidden="true" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="m6 6 12 12M18 6 6 18" /></svg>
    </button>
  </div>
</aside>

<script>
  import { cartNotification } from '../../store/cartStore';

  const notice = document.querySelector<HTMLElement>('#cart-notification')!;
  const message = notice.querySelector<HTMLElement>('[data-cart-message]')!;
  let timer: ReturnType<typeof setTimeout> | undefined;
  const dismiss = () => {
    clearTimeout(timer);
    notice.hidden = true;
    message.textContent = '';
  };
  const scheduleDismiss = () => {
    clearTimeout(timer);
    timer = setTimeout(() => {
      if (!notice.matches(':hover') && !notice.contains(document.activeElement)) dismiss();
    }, 6000);
  };

  cartNotification.subscribe((notification) => {
    if (!notification) return;
    notice.hidden = false;
    message.textContent = notification.message;
    scheduleDismiss();
  });
  notice.querySelector('[data-cart-dismiss]')!.addEventListener('click', dismiss);
  notice.addEventListener('mouseenter', () => clearTimeout(timer));
  notice.addEventListener('mouseleave', scheduleDismiss);
  notice.addEventListener('focusin', () => clearTimeout(timer));
  notice.addEventListener('focusout', scheduleDismiss);
</script>
