---
import type { Post } from '../../types/blog';
import { htmlToText, summarize } from '../../lib/sanitize';

interface Props {
  post: Pick<Post, 'title' | 'slug' | 'date' | 'excerpt' | 'featuredImage' | 'categories'>;
}
const { post } = Astro.props;

const summary = summarize(htmlToText(post.excerpt), 140);
const category = post.categories?.nodes?.[0]?.name;
const date = new Date(post.date).toLocaleDateString('es-CL', { day: 'numeric', month: 'long', year: 'numeric' });
---
<a href={`/blog/${post.slug}`} class="group block bg-white rounded-2xl border border-[#E8E2D7] shadow-sm hover:shadow-md hover:-translate-y-1 transition-all duration-300 overflow-hidden">
  <div class="relative h-48 overflow-hidden">
    {post.featuredImage?.node?.sourceUrl ? (
      <img
        src={post.featuredImage.node.sourceUrl}
        alt={post.featuredImage.node.altText ?? post.title}
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
      />
    ) : (
      <div class="w-full h-full bg-spa-sand" />
    )}
    {category && (
      <span class="absolute top-3 left-3 bg-white/90 text-spa-charcoal text-[10px] font-bold px-2.5 py-1 rounded-full uppercase tracking-wider">
        {category}
      </span>
    )}
  </div>
  <div class="p-6">
    <span class="text-[11px] text-spa-taupe uppercase tracking-wide">{date}</span>
    <h3 class="font-editorial text-xl font-semibold text-spa-charcoal mt-1.5 mb-2 leading-snug line-clamp-2 group-hover:text-spa-taupe transition-colors">
      {post.title}
    </h3>
    <p class="text-sm text-[#6E5C4E] leading-relaxed line-clamp-3">{summary}</p>
  </div>
</a>
