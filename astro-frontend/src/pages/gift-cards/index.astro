---
// Las gift cards se compran desde cada producto ("Quiero mi giftcard").
// SSR (no prerender): así activar/desactivar un producto como gift card
// (wp-admin → Marketing → Gift Cards → Productos) se ve al instante, sin deploy.
export const prerender = false;

import ECommerceLayout from '../../layouts/ECommerceLayout.astro';
import ProductCard from '../../components/catalog/ProductCard.astro';
import { wpQuery } from '../../lib/wp-graphql';
import { GET_PRODUCTS } from '../../lib/queries/products';
import type { SimpleProduct } from '../../types/catalog';

const steps = [
  { title: 'Elige un regalo', text: 'Busca el tratamiento o producto que quieres regalar y presiona "Quiero mi giftcard".' },
  { title: 'Personaliza', text: 'Ingresa tu email, el del destinatario y un mensaje personalizado.' },
  { title: 'Paga', text: 'Completa el pago en el checkout. El destinatario recibe su código por email.' },
  { title: 'Canjea', text: 'Al comprar ese producto, ingresa el código en el checkout y queda sin costo.' },
];

// Sin `first` explícito GET_PRODUCTS usa 24 y deja fuera la mayor parte del catálogo.
let giftProducts: SimpleProduct[] = [];
try {
  const data = await wpQuery<{ products: { nodes: SimpleProduct[] } }>({
    query: GET_PRODUCTS,
    variables: { first: 200 },
  });
  // Solo productos habilitados como gift card (wp-admin → Gift Cards → Productos).
  giftProducts = data.products.nodes.filter((p) => p.giftCardEnabled !== false);
} catch {
  // WordPress no disponible en build time — se muestra el aviso de "sin resultados".
}
---
<ECommerceLayout title="Gift Cards">
  <div class="bg-spa-taupe-dark text-white py-16 px-4 sm:px-6 lg:px-8">
    <div class="max-w-2xl mx-auto text-center">
      <span class="text-xs font-semibold tracking-[0.2em] uppercase text-white/70 block mb-3">Un detalle que se transforma en experiencia</span>
      <h1 class="font-editorial text-3xl sm:text-5xl font-light">Gift Cards</h1>
      <p class="mt-4 text-white/80 leading-relaxed">
        Regala una experiencia de bienestar: el destinatario canjea su código y disfruta el tratamiento sin costo.
      </p>
    </div>
  </div>

  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16">
    <ol class="grid sm:grid-cols-2 gap-5">
      {steps.map((step, i) => (
        <li class="bg-white rounded-2xl border border-[#E8E2D7] p-6">
          <span class="font-editorial text-2xl text-spa-taupe">{i + 1}</span>
          <h2 class="font-editorial text-xl text-spa-charcoal mt-1">{step.title}</h2>
          <p class="text-sm text-spa-taupe mt-2 leading-relaxed">{step.text}</p>
        </li>
      ))}
    </ol>
  </div>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pb-16">
    {giftProducts.length > 0 ? (
      <>
        <div class="max-w-xl mx-auto mb-10">
          <span class="text-xs font-semibold tracking-[0.2em] uppercase text-spa-taupe block mb-3 text-center">Elige qué regalar</span>
          <div class="relative">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="absolute left-4 top-1/2 -translate-y-1/2 text-spa-taupe">
              <circle cx="11" cy="11" r="8" /><path d="m21 21-4.3-4.3" />
            </svg>
            <input
              type="text"
              id="giftcard-search"
              placeholder="Busca el tratamiento que quieres regalar…"
              class="w-full border border-[#DDD5CA] rounded-full pl-11 pr-5 py-3.5 text-sm bg-white focus:outline-none focus:border-spa-taupe placeholder:text-spa-taupe"
            />
          </div>
        </div>

        <div id="giftcard-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
          {giftProducts.map((product) => (
            <div data-search={product.name.toLowerCase()}>
              <ProductCard product={product} href={`/tienda/${product.slug}`} />
            </div>
          ))}
        </div>
        <p id="giftcard-empty" class="text-sm text-spa-taupe text-center py-10" hidden>
          No encontramos ese tratamiento. Prueba con otra palabra o revisa el catálogo completo.
        </p>
      </>
    ) : (
      <p class="text-sm text-spa-taupe text-center">Por ahora no hay productos disponibles para regalar. Vuelve a intentarlo más tarde.</p>
    )}
    <div class="text-center mt-10">
      <a href="/tienda" class="inline-block text-xs font-semibold tracking-wider uppercase text-[#6E5C4E] hover:text-spa-charcoal border border-[#DDD5CA] px-6 py-3 rounded-full hover:bg-white transition-colors">
        Ver catálogo completo
      </a>
    </div>
  </div>
</ECommerceLayout>

<script>
  import { addToCart } from '../../store/cartStore';

  document.querySelectorAll<HTMLButtonElement>('[data-add-to-cart]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const id = Number(btn.dataset.addToCart);
      addToCart(id, 1);
    });
  });

  const search = document.getElementById('giftcard-search') as HTMLInputElement | null;
  const cards = [...document.querySelectorAll<HTMLElement>('#giftcard-grid > [data-search]')];
  const empty = document.getElementById('giftcard-empty');

  search?.addEventListener('input', () => {
    const q = search.value.trim().toLowerCase();
    let visible = 0;
    cards.forEach((card) => {
      const match = !q || (card.dataset.search ?? '').includes(q);
      card.hidden = !match;
      if (match) visible++;
    });
    if (empty) empty.hidden = visible > 0;
  });
</script>
