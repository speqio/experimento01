---
// Las gift cards se compran desde cada producto ("Quiero mi giftcard").
// SSR (no prerender): así activar/desactivar un producto como gift card
// (wp-admin → Marketing → Gift Cards → Productos) se ve al instante, sin deploy.
export const prerender = false;

import PageBanner from '../../components/common/PageBanner.astro';
import ECommerceLayout from '../../layouts/ECommerceLayout.astro';
import ProductCard from '../../components/catalog/ProductCard.astro';
import { wpQuery, kvCacheFrom } from '../../lib/wp-graphql';
import { fetchLayoutData } from '../../lib/layoutData';
import { GET_PRODUCTS } from '../../lib/queries/products';
import type { SimpleProduct } from '../../types/catalog';

const layoutDataPromise = fetchLayoutData(kvCacheFrom(Astro));

const steps = [
  { title: 'Elige un regalo', text: 'Elige el tratamiento o producto que quieres regalar y entra a su ficha para preparar tu Gift Card.' },
  { title: 'Personaliza', text: 'Ingresa tu email, el del destinatario y un mensaje personalizado.' },
  { title: 'Paga', text: 'Completa el pago en el checkout. El destinatario recibe su código por email.' },
  { title: 'Canjea', text: 'Al comprar ese producto, ingresa el código en el checkout y queda sin costo.' },
];

// Sin `first` explícito GET_PRODUCTS usa 24 y deja fuera la mayor parte del catálogo.
let giftProducts: SimpleProduct[] = [];
try {
  const data = await wpQuery<{ products: { nodes: SimpleProduct[] } }>({
    query: GET_PRODUCTS,
    variables: { first: 200 },
    cache: kvCacheFrom(Astro),
  });
  // Solo productos habilitados como gift card (wp-admin → Gift Cards → Productos).
  giftProducts = data.products.nodes.filter((p) => p.giftCardEnabled !== false);
} catch {
  // WordPress no disponible en build time — se muestra el aviso de "sin resultados".
}
const cardImage = (await layoutDataPromise).giftCardImageUrl || '/gift-card.webp';
---
<ECommerceLayout title="Gift Cards" layoutData={layoutDataPromise}>
  <div class="gift-hero-shell">
    <section class="gift-hero" aria-labelledby="gift-page-title">
      <div class="gift-hero-inner">
        <div class="gift-hero-copy">
          <h1 id="gift-page-title" class="font-editorial">Gift Cards</h1>
          <p class="gift-hero-description">Regala una experiencia de bienestar: el destinatario canjea su código y disfruta el tratamiento sin costo.</p>
          <p class="gift-hero-context">Un detalle que se transforma en experiencia</p>
          <div class="gift-hero-actions">
            <a href="#giftcard-catalog" class="gift-page-button gift-page-button-primary">
              Elegir mi regalo
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6" /></svg>
            </a>
            <a href="#como-funciona" class="gift-help-link">Cómo funciona</a>
          </div>
        </div>
        <figure class="gift-hero-preview">
          <img src={cardImage} alt="Gift Card de Mándala Spa" width="1200" height="851" loading="eager" fetchpriority="high" />
          <figcaption>Un regalo para disfrutar con calma.</figcaption>
        </figure>
      </div>
    </section>
  </div>

  <section id="como-funciona" class="gift-guide max-w-6xl mx-auto px-4 sm:px-6 lg:px-8" aria-labelledby="gift-guide-title">
    <details data-gift-guide>
      <summary>
        <h2 id="gift-guide-title" class="font-editorial">Cómo regalar una experiencia</h2>
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
      </summary>
      <ol class="gift-steps">
        {steps.map((step, i) => (
          <li>
            <span class="gift-step-number" aria-hidden="true">{i + 1}</span>
            <div>
              <h3 class="font-editorial">{step.title}</h3>
              <p>{step.text}</p>
            </div>
          </li>
        ))}
      </ol>
    </details>
  </section>

  <section id="giftcard-catalog" class="gift-catalog max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pb-16" aria-labelledby="gift-catalog-title">
    {giftProducts.length > 0 ? (
      <>
        <div class="gift-catalog-toolbar">
          <div>
            <h2 id="gift-catalog-title" class="font-editorial">Elige qué regalar</h2>
            <p id="giftcard-count" role="status" aria-live="polite" aria-atomic="true">{giftProducts.length} opciones disponibles</p>
          </div>
          <div class="gift-search" role="search" aria-label="Buscar Gift Cards">
            <label for="giftcard-search">Buscar una experiencia o producto</label>
            <div class="gift-search-field">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="11" cy="11" r="8" /><path d="m21 21-4.3-4.3" /></svg>
              <input type="search" id="giftcard-search" placeholder="Masajes, faciales, spa…" autocomplete="off" aria-controls="giftcard-grid" />
              <button type="button" data-gift-search-clear aria-label="Limpiar búsqueda" hidden>
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><path d="m6 6 12 12M6 18 18 6" /></svg>
              </button>
            </div>
          </div>
        </div>

        <div id="giftcard-grid" class="gift-grid grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
          {giftProducts.map((product) => (
            <div data-search={product.name.toLowerCase()}>
              <ProductCard product={product} href={`/producto/${product.slug}`} giftOnly />
            </div>
          ))}
        </div>
        <div id="giftcard-empty" class="gift-empty" hidden>
          <h3 class="font-editorial">No encontramos esa experiencia</h3>
          <p>Prueba con otra palabra o limpia la búsqueda para volver a ver todas las opciones.</p>
          <button type="button" data-gift-search-reset class="gift-page-button">Ver todas las opciones</button>
        </div>
      </>
    ) : (
      <div class="gift-empty"><h2 id="gift-catalog-title" class="font-editorial">Pronto, más experiencias para regalar</h2><p>Por ahora no hay productos disponibles para regalar. Vuelve a intentarlo más tarde.</p></div>
    )}
    <div class="text-center mt-10">
      <a href="/tienda" class="gift-page-button">
        Ver catálogo completo
      </a>
    </div>
  </section>
</ECommerceLayout>

<style>
  .gift-hero-shell { padding: 12px 12px 0; }
  .gift-hero { overflow: hidden; border-radius: 20px; background: #F1ECE4; color: #2C2724; }
  .gift-hero-inner { display: grid; align-items: center; gap: 32px; max-width: 72rem; margin-inline: auto; padding: 36px 24px; }
  .gift-hero h1 { font-size: clamp(2.75rem, 5.5vw, 4.5rem); line-height: 1.05; font-weight: 400; letter-spacing: -.025em; }
  .gift-hero-description { max-width: 45ch; margin-top: 20px; font-size: 16px; line-height: 1.8; color: #4A3E34; text-wrap: pretty; }
  .gift-hero-context { margin-top: 14px; font-size: 13px; line-height: 1.7; color: #675647; }
  .gift-hero-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 24px; margin-top: 24px; }
  .gift-page-button { display: inline-flex; align-items: center; justify-content: center; gap: 10px; width: fit-content; max-width: 100%; min-height: 48px; padding: 12px 24px; border: 1px solid #C7B8A7; border-radius: 999px; color: #3D3530; font-size: 14px; font-weight: 500; line-height: 1.5; transition: background-color 150ms ease; }
  .gift-page-button:hover, .gift-page-button:active { background: #EEE7DD; }
  .gift-page-button-primary { border-color: #2C2724; background: #2C2724; color: white; }
  .gift-page-button-primary:hover, .gift-page-button-primary:active { background: #4A403A; }
  .gift-help-link { display: inline-flex; align-items: center; min-height: 48px; color: #675647; font-size: 14px; text-decoration: underline; text-underline-offset: 4px; }
  .gift-hero-preview { min-width: 0; width: 100%; max-width: 300px; margin: 8px auto 0; padding: 8px; }
  .gift-hero-preview img { display: block; width: 100%; height: auto; border-radius: 12px; transform: rotate(-3deg); box-shadow: 0 16px 36px -18px #3D35304d; }
  .gift-hero-preview figcaption { margin-top: 24px; color: #675647; text-align: center; font-family: 'Cormorant Garamond', Georgia, serif; font-size: 20px; }
  .gift-guide { padding-top: 32px; padding-bottom: 36px; scroll-margin-top: 24px; }
  .gift-guide details { border-bottom: 1px solid #DDD3C6; }
  .gift-guide summary { display: flex; align-items: center; justify-content: space-between; gap: 16px; min-height: 56px; padding-block: 12px; color: #3D3530; list-style: none; cursor: pointer; }
  .gift-guide summary::-webkit-details-marker { display: none; }
  .gift-guide summary h2 { font-size: 1.625rem; font-weight: 400; line-height: 1.2; }
  .gift-guide summary svg { flex-shrink: 0; }
  .gift-guide details[open] > summary svg { transform: rotate(180deg); }
  .gift-steps { display: grid; gap: 24px; padding: 24px 0 32px; }
  .gift-steps li { display: flex; align-items: flex-start; gap: 14px; min-width: 0; }
  .gift-step-number { display: flex; align-items: center; justify-content: center; width: 28px; height: 28px; flex-shrink: 0; border-radius: 50%; background: #EEE7DD; color: #675647; font-size: 12px; }
  .gift-steps h3 { font-size: 1.5rem; font-weight: 500; line-height: 1.2; color: #3D3530; }
  .gift-steps p { margin-top: 10px; color: #675647; font-size: 14px; line-height: 1.75; }
  .gift-catalog { scroll-margin-top: 24px; }
  .gift-catalog-toolbar { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 24px; padding-bottom: 24px; margin-bottom: 28px; border-bottom: 1px solid #DDD3C6; }
  .gift-catalog-toolbar h2 { color: #2C2724; font-size: clamp(2rem, 3.5vw, 2.75rem); line-height: 1.12; font-weight: 400; letter-spacing: -.02em; }
  #giftcard-count { margin-top: 10px; color: #675647; font-size: 13px; font-variant-numeric: tabular-nums; }
  .gift-search { width: 100%; max-width: 380px; }
  .gift-search label { display: block; margin-bottom: 8px; color: #675647; font-size: 12px; }
  .gift-search-field { position: relative; display: flex; align-items: center; }
  .gift-search-field > svg { position: absolute; left: 16px; color: #675647; pointer-events: none; }
  .gift-search input { width: 100%; min-height: 52px; padding: 12px 48px 12px 44px; border: 1px solid #C7B8A7; border-radius: 999px; background: #FDFBF7; color: #3D3530; font-size: 16px; line-height: 1.5; }
  .gift-search input::placeholder { color: #796859; }
  .gift-search input::-webkit-search-cancel-button { appearance: none; }
  .gift-search-field button { position: absolute; right: 4px; display: flex; align-items: center; justify-content: center; width: 44px; height: 44px; border-radius: 50%; color: #675647; }
  .gift-search-field button:hover { background: #EEE7DD; }
  .gift-grid > div { min-width: 0; }
  .gift-grid > div :global(.product-card) { height: 100%; }
  .gift-grid > div[hidden], .gift-search-field button[hidden], .gift-empty[hidden] { display: none; }
  .gift-empty { padding: 40px 24px; border-radius: 16px; background: #F1ECE4; text-align: center; }
  .gift-empty h3, .gift-empty h2 { color: #3D3530; font-size: 1.875rem; line-height: 1.2; }
  .gift-empty p { max-width: 48ch; margin: 12px auto 20px; color: #675647; font-size: 14px; line-height: 1.7; }
  :is(.gift-hero, .gift-guide, .gift-catalog) :is(a, button, input, summary):focus-visible { outline: 2px solid #675647; outline-offset: 3px; }
  @media (min-width: 640px) { .gift-hero-shell { padding: 16px 24px 0; } .gift-hero { border-radius: 28px; } .gift-steps { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 768px) {
    .gift-hero-inner { grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); gap: 48px; min-height: 400px; padding: 44px 32px; }
    .gift-hero-preview { max-width: 420px; }
    .gift-guide { padding-top: 44px; padding-bottom: 52px; }
    .gift-steps { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 24px; }
    .gift-steps li { flex-direction: column; gap: 12px; }
  }
  @media (min-width: 1024px) { .gift-hero-shell { padding: 24px 32px 0; } .gift-hero { border-radius: 36px; } .gift-hero-inner { padding-block: 56px; } }
  @media (prefers-reduced-motion: reduce) { .gift-page-button { transition: none; } }
</style>

<script>
  const guide = document.querySelector<HTMLDetailsElement>('[data-gift-guide]');
  const desktop = window.matchMedia('(min-width: 768px)');
  const syncGuide = () => { if (guide) guide.open = desktop.matches; };
  desktop.addEventListener('change', syncGuide);
  syncGuide();
  document.querySelector('.gift-help-link')?.addEventListener('click', () => { if (guide) guide.open = true; });

  const search = document.getElementById('giftcard-search') as HTMLInputElement | null;
  const cards = [...document.querySelectorAll<HTMLElement>('#giftcard-grid > [data-search]')];
  const empty = document.getElementById('giftcard-empty');
  const count = document.getElementById('giftcard-count');
  const clear = document.querySelector<HTMLButtonElement>('[data-gift-search-clear]');
  const normalize = (text: string) => text.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase();
  const updateSearch = () => {
    const query = normalize(search?.value.trim() ?? '');
    let visible = 0;
    cards.forEach((card) => {
      const matches = !query || normalize(card.dataset.search ?? '').includes(query);
      card.hidden = !matches;
      if (matches) visible++;
    });
    if (empty) empty.hidden = visible > 0;
    if (clear) clear.hidden = !search?.value;
    if (count) count.textContent = query
      ? `${visible} ${visible === 1 ? 'resultado' : 'resultados'}`
      : `${visible} opciones disponibles`;
  };
  const resetSearch = () => { if (search) { search.value = ''; updateSearch(); search.focus(); } };
  search?.addEventListener('input', updateSearch);
  clear?.addEventListener('click', resetSearch);
  document.querySelector('[data-gift-search-reset]')?.addEventListener('click', resetSearch);
</script>
