---
// Venta directa de gift cards (sin pasar por un servicio de spa).
export const prerender = true;

import ECommerceLayout from '../../layouts/ECommerceLayout.astro';
import GiftCardForm from '../../components/giftcard/GiftCardForm.tsx';
import { wpQuery } from '../../lib/wp-graphql';
import { GET_GIFTCARD_PRODUCTS } from '../../lib/queries/giftcards';
import type { SimpleProduct } from '../../types/catalog';

let giftCardProduct: SimpleProduct | undefined;
try {
  const data = await wpQuery<{ products: { nodes: SimpleProduct[] } }>({
    query: GET_GIFTCARD_PRODUCTS,
  });
  giftCardProduct = data.products.nodes[0];
} catch {
  // WordPress aún no configurado/disponible en build time.
}
---
<ECommerceLayout title="Gift Cards">
  <div class="bg-spa-taupe-dark text-white py-16 px-4 sm:px-6 lg:px-8">
    <div class="max-w-2xl mx-auto text-center">
      <span class="text-xs font-semibold tracking-[0.2em] uppercase text-white/70 block mb-3">Un detalle que se transforma en experiencia</span>
      <h1 class="font-editorial text-3xl sm:text-5xl font-light">Gift Cards</h1>
      <p class="mt-4 text-white/80 leading-relaxed">
        Regala saldo para usar en cualquier producto o servicio. Se puede usar completo o combinar con otro medio de pago.
      </p>
    </div>
  </div>

  <div class="max-w-lg mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16">
    {giftCardProduct ? (
      <GiftCardForm client:load productId={giftCardProduct.databaseId} />
    ) : (
      <p class="text-sm text-spa-taupe text-center">Configura el producto de Gift Card en WooCommerce (ver docs/wp-setup-guide.md §5).</p>
    )}
  </div>
</ECommerceLayout>
