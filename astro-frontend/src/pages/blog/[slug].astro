---
// SSR (no prerender): coherente con blog/index.astro — no hace falta rebuild
// para que un artículo nuevo tenga su página de detalle.
export const prerender = false;

import ECommerceLayout from '../../layouts/ECommerceLayout.astro';
import { wpQuery, kvCacheFrom } from '../../lib/wp-graphql';
import { fetchLayoutData } from '../../lib/layoutData';
import { GET_POST_BY_SLUG } from '../../lib/queries/posts';
import { cleanHtml, htmlToText, summarize } from '../../lib/sanitize';
import type { Post } from '../../types/blog';

const { slug } = Astro.params;
const layoutDataPromise = fetchLayoutData(kvCacheFrom(Astro));

let post: Post | null = null;
try {
  const data = await wpQuery<{ post: Post | null }>({
    query: GET_POST_BY_SLUG,
    variables: { slug },
    cache: kvCacheFrom(Astro),
  });
  post = data.post;
} catch {
  post = null;
}

if (!post) {
  return Astro.redirect('/blog');
}

const date = new Date(post.date).toLocaleDateString('es-CL', { day: 'numeric', month: 'long', year: 'numeric' });
const category = post.categories?.nodes?.[0]?.name;
const description = summarize(htmlToText(post.excerpt), 160);
const content = cleanHtml(post.content);
---
<ECommerceLayout title={post.title} description={description} layoutData={layoutDataPromise}>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-3.5">
    <nav class="flex items-center flex-wrap gap-1.5 text-xs text-spa-taupe" aria-label="Breadcrumb">
      <a href="/" class="hover:text-spa-charcoal transition-colors">Inicio</a>
      <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6" /></svg>
      <a href="/blog" class="hover:text-spa-charcoal transition-colors">Blog</a>
    </nav>
  </div>

  <article class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">
    {category && (
      <span class="text-xs font-semibold tracking-[0.2em] uppercase text-spa-taupe block mb-3">{category}</span>
    )}
    <h1 class="font-editorial text-3xl sm:text-4xl font-medium text-spa-charcoal leading-tight mb-3">{post.title}</h1>
    <p class="text-xs text-spa-taupe uppercase tracking-wide mb-8">{date}</p>

    {post.featuredImage?.node?.sourceUrl && (
      <img
        src={post.featuredImage.node.sourceUrl}
        alt={post.featuredImage.node.altText ?? post.title}
        class="w-full h-64 sm:h-96 object-cover rounded-2xl mb-10"
      />
    )}

    <div
      class="text-[#4A4036] text-sm sm:text-base leading-relaxed [&_p]:mb-4 last:[&_p]:mb-0 [&_ul]:list-disc [&_ul]:pl-5 [&_ul]:mb-4 [&_li]:mb-1 [&_h2]:font-editorial [&_h2]:text-2xl [&_h2]:text-spa-charcoal [&_h2]:mt-8 [&_h2]:mb-3 [&_h3]:font-semibold [&_h3]:text-spa-charcoal [&_h3]:mt-6 [&_h3]:mb-2 [&_strong]:text-spa-charcoal [&_a]:text-spa-taupe-dark [&_a]:underline"
      set:html={content}
    />

    <div class="mt-12 pt-8 border-t border-[#E8E2D7] text-center">
      <a href="/blog" class="inline-block text-xs font-semibold tracking-wider uppercase text-[#6E5C4E] hover:text-spa-charcoal border border-[#DDD5CA] px-6 py-3 rounded-full hover:bg-white transition-colors">
        &larr; Volver al blog
      </a>
    </div>
  </article>
</ECommerceLayout>
