---
// SSR (no prerender): un artículo nuevo aparece sin esperar un deploy,
// igual que /promociones y /tienda.
export const prerender = false;

import PageBanner from '../../components/common/PageBanner.astro';
import ECommerceLayout from '../../layouts/ECommerceLayout.astro';
import BlogCard from '../../components/blog/BlogCard.astro';
import { wpQuery, kvCacheFrom } from '../../lib/wp-graphql';
import { fetchLayoutData } from '../../lib/layoutData';
import { GET_POSTS } from '../../lib/queries/posts';
import type { Post } from '../../types/blog';

const layoutDataPromise = fetchLayoutData(kvCacheFrom(Astro));

let posts: Post[] = [];
try {
  const data = await wpQuery<{ posts: { nodes: Post[] } }>({
    query: GET_POSTS,
    variables: { first: 24 },
    cache: kvCacheFrom(Astro),
  });
  posts = data.posts.nodes;
} catch {
  // WordPress aún no disponible — se muestra el aviso de abajo.
}
---
<ECommerceLayout title="Blog" description="Consejos de bienestar, cuidado personal y novedades de Mándala Spa." layoutData={layoutDataPromise}>
  <PageBanner title="Blog" description="Notas y consejos para tu rutina de bienestar." context="Bienestar & autocuidado" />

  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-14">
    {posts.length > 0 ? (
      <div data-stagger class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
        {posts.map((post) => <BlogCard post={post} />)}
      </div>
    ) : (
      <p class="text-sm text-spa-taupe text-center">Todavía no hay artículos publicados.</p>
    )}
  </div>
</ECommerceLayout>
