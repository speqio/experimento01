---
// /contacto/ (misma URL que spamandala.cl). Tiene prioridad sobre [...page].astro; título y descripción de Yoast.
export const prerender = false;

import PageBanner from '../components/common/PageBanner.astro';
import ECommerceLayout from '../layouts/ECommerceLayout.astro';
import ContactForm from '../components/common/ContactForm.astro';
import { SITE_INFO, RESERVO_URL } from '../lib/siteInfo';
import { businessSchema } from '../lib/seo';
import pages from '../data/paginas-wp.json';

const wp = pages.find((p) => p.path === 'contacto');
const mapsUrl = 'https://www.google.com/maps/search/?api=1&query=Presidente+Err%C3%A1zuriz+2933+Las+Condes';
const whatsappUrl = `https://wa.me/${SITE_INFO.whatsapp}?text=${encodeURIComponent('Hola Mándala Spa, quisiera agendar una hora.')}`;
const card = 'bg-white rounded-2xl border border-[#E8E2D7] p-6 flex gap-4';
const iconBox = 'w-11 h-11 rounded-full bg-spa-sand text-spa-taupe-dark flex items-center justify-center shrink-0';
const label = 'text-[11px] font-semibold tracking-[0.2em] text-spa-taupe uppercase mb-1';
const breadcrumbs = [{ name: 'Contacto', path: '/contacto/' }];
---
<ECommerceLayout
  title="Contacto"
  description={wp?.description || 'Agenda por WhatsApp o escríbenos. Presidente Errázuriz 2933, Oficina B, Las Condes.'}
  breadcrumbs={breadcrumbs} breadcrumbsInBanner
  schema={[businessSchema(Astro.url.origin)]}
>
  <PageBanner
    title="Hoy es el mejor día para dedicarte a ti"
    description="Agenda tu hora por WhatsApp o en línea, o déjanos tus dudas y te responderemos a la brevedad."
    breadcrumbs={breadcrumbs}
  />

  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16 grid lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] gap-8 lg:gap-12 items-start">
    <div class="space-y-4">
      <div class={card}>
        <span class={iconBox}><svg viewBox="0 0 24 24" class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z" /></svg></span>
        <div class="min-w-0">
          <p class={label}>Agenda por WhatsApp</p>
          <a href={whatsappUrl} target="_blank" rel="noopener" class="text-lg text-spa-charcoal font-medium hover:underline underline-offset-4">(+56 9) 9224 2180</a>
          <p class="text-sm text-spa-taupe">Llámanos o escríbenos.</p>
        </div>
      </div>

      <div class={card}>
        <span class={iconBox}><svg viewBox="0 0 24 24" class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="17" rx="2" /><path d="M16 2v4M8 2v4M3 10h18" /></svg></span>
        <div class="min-w-0">
          <p class={label}>Agenda en línea</p>
          <a href={RESERVO_URL} target="_blank" rel="noopener" class="inline-block mt-1 bg-spa-charcoal hover:bg-[#433B36] text-white px-5 py-2.5 rounded-full text-xs font-semibold tracking-[0.15em] uppercase transition-colors">Agendar ahora</a>
        </div>
      </div>

      <div class={card}>
        <span class={iconBox}><svg viewBox="0 0 24 24" class="w-5 h-5" fill="currentColor"><path d="M20 4H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2Zm0 4-8 5-8-5V6l8 5 8-5Z" /></svg></span>
        <div class="min-w-0 space-y-2 text-sm">
          <p class={label}>Correo</p>
          <p><span class="text-spa-taupe">Dudas y reservas:</span><br /><a href={`mailto:${SITE_INFO.email}`} class="text-spa-charcoal hover:underline underline-offset-4 break-all">{SITE_INFO.email}</a></p>
          <p><span class="text-spa-taupe">Convenios:</span><br /><a href={`mailto:${SITE_INFO.legalEmail}`} class="text-spa-charcoal hover:underline underline-offset-4 break-all">{SITE_INFO.legalEmail}</a></p>
        </div>
      </div>

      <div class={card}>
        <span class={iconBox}><svg viewBox="0 0 24 24" class="w-5 h-5" fill="currentColor"><path d="M12 2a7 7 0 0 0-7 7c0 5.25 7 13 7 13s7-7.75 7-13a7 7 0 0 0-7-7Zm0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5Z" /></svg></span>
        <div class="min-w-0 text-sm">
          <p class={label}>Visítanos</p>
          <p class="text-spa-charcoal">{SITE_INFO.streetAddress}<br />Las Condes, Santiago</p>
          <a href={mapsUrl} target="_blank" rel="noopener" class="inline-block mt-2 text-xs font-semibold tracking-wider uppercase text-spa-taupe-dark hover:text-spa-charcoal">Cómo llegar →</a>
        </div>
      </div>

      <div class={card}>
        <span class={iconBox}><svg viewBox="0 0 20 20" class="w-5 h-5" fill="currentColor"><path fill-rule="evenodd" d="M10 18.33a8.33 8.33 0 1 0 0-16.66 8.33 8.33 0 0 0 0 16.66ZM10.83 5a.83.83 0 0 0-1.66 0v5c0 .32.18.6.46.75l3.33 1.66a.83.83 0 1 0 .75-1.49l-2.88-1.43Z" /></svg></span>
        <div class="min-w-0 text-sm">
          <p class={label}>Horario de atención</p>
          <ul class="text-spa-charcoal space-y-0.5">
            {SITE_INFO.hours.map((h) => <li>{h.label}: {h.opens} – {h.closes} hrs</li>)}
            <li class="text-spa-taupe">Domingo: cerrado</li>
          </ul>
        </div>
      </div>
    </div>

    <div class="lg:sticky lg:top-28">
      <ContactForm />
      <p class="text-xs text-spa-taupe mt-4 px-2">
        Al enviar aceptas nuestras <a href="/politicas-de-privacidad" class="underline underline-offset-4">políticas de privacidad</a>.
      </p>
    </div>
  </div>
</ECommerceLayout>
