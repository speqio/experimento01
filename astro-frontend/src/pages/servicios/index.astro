---
export const prerender = true;

import ECommerceLayout from '../../layouts/ECommerceLayout.astro';
import { wpQuery } from '../../lib/wp-graphql';
import { GET_SERVICES } from '../../lib/queries/services';
import type { SpaService } from '../../types/catalog';

let services: SpaService[] = [];
try {
  const data = await wpQuery<{ spaServices: { nodes: SpaService[] } }>({
    query: GET_SERVICES,
  });
  services = data.spaServices.nodes;
} catch {
  // WordPress aún no configurado/disponible en build time.
}
---
<ECommerceLayout title="Servicios de Spa">
  <h1 class="text-2xl font-semibold mb-6">Servicios de Spa</h1>
  <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
    {services.map((service) => (
      <a href={`/servicios/${service.slug}`} class="block border rounded-lg overflow-hidden hover:shadow-md">
        <img src={service.featuredImage.sourceUrl} alt={service.title} class="w-full aspect-square object-cover" />
        <div class="p-4">
          <h3 class="font-medium">{service.title}</h3>
          <p class="text-sm text-gray-600">{service.spaFields.durationMinutes} min · {service.spaFields.intensityLevel}</p>
        </div>
      </a>
    ))}
  </div>
</ECommerceLayout>
