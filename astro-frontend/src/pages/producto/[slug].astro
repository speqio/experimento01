---
// SSR (no prerender): así los cambios de wp-admin (gift card activa/inactiva,
// precio, descripción, etc.) se ven al instante, sin esperar un deploy — mismo
// criterio que /tienda, /promociones y /blog.
export const prerender = false;

import Breadcrumbs from '../../components/common/Breadcrumbs.astro';
import ECommerceLayout from '../../layouts/ECommerceLayout.astro';
import { wpQuery, kvCacheFrom } from '../../lib/wp-graphql';
import { fetchLayoutData } from '../../lib/layoutData';
import { GET_PRODUCT_BY_SLUG, GET_PRODUCTS_BY_CATEGORIES } from '../../lib/queries/products';
import {
  getProductDuration,
  getProductBadge,
  extractDuration,
  parseProductSections,
  getProductTagline,
  getCardSummary,
  getPriceDisplay,
  formatPriceDisplay,
  hasAnyDiscount,
  clampIntroWords,
} from '../../lib/parse';
import { getUpsellsFor } from '../../lib/queries/upsells';
import type { SimpleProduct } from '../../types/catalog';

const { slug } = Astro.params;
const cache = kvCacheFrom(Astro);
const layoutDataPromise = fetchLayoutData(cache);
let product: SimpleProduct | null = null;
try {
  const data = await wpQuery<{ product: SimpleProduct | null }>({
    query: GET_PRODUCT_BY_SLUG,
    variables: { slug },
    cache,
  });
  product = data.product;
} catch {
  // El CMS falló o tardó: no es un producto inexistente. Un 404 aquí le haría creer a Google que la ficha ya no existe.
  return new Response('Servicio no disponible, intenta de nuevo en unos segundos.', { status: 503, headers: { 'Retry-After': '30' } });
}

if (!product) {
  return new Response(null, { status: 404 });
}

const duration = getProductDuration(product.attributes) ?? extractDuration(product.shortDescription ?? '').duration;
const tagline = getProductTagline(product.shortDescription ?? '');
const categoryName = product.productCategories?.nodes?.[0]?.name ?? 'Tienda';
const categorySlug = product.productCategories?.nodes?.[0]?.slug;
const badge = getProductBadge(product.name);
const priceInfo = getPriceDisplay(product.price, product.regularPrice);
const variations: { databaseId: number; price?: string; regularPrice?: string; attributes: { nodes: { name: string; value: string }[] } }[] =
  (product as any).variations?.nodes ?? [];
const variantAttrs = variations[0]
  ? variations[0].attributes.nodes.map((a) => ({
      name: a.name,
      options: [...new Set(variations.map((v) => v.attributes.nodes.find((x) => x.name === a.name)?.value ?? ''))].filter(Boolean),
    }))
  : [];
const sections = parseProductSections(product.description ?? '');
const uniqueItems = (items: string[]) => [...new Set(items.map((item) => item.trim()))];
const { intro: introHtml, extras } = sections;
const benefits = uniqueItems(sections.benefits);
const includes = uniqueItems(sections.includes);
const indicatedFor = uniqueItems(sections.indicatedFor);
const contraindications = uniqueItems(sections.contraindications);
const intro = clampIntroWords(introHtml);

const [upsells, relatedResult] = await Promise.all([
  getUpsellsFor(product.databaseId, cache),
  categorySlug
    ? wpQuery<{ products: { nodes: SimpleProduct[] } }>({
        query: GET_PRODUCTS_BY_CATEGORIES,
        variables: { categoryIn: [categorySlug], first: 4 },
        cache,
      }).catch(() => null)
    : Promise.resolve(null),
]);
const firstCategory = product.productCategories?.nodes?.[0] as { name: string; slug: string; parent?: { node: { slug: string } } | null } | undefined;
const breadcrumbs = [
  { name: 'Tienda', path: '/tienda' },
  ...(firstCategory ? [{ name: firstCategory.name, path: `/categoria-producto/${firstCategory.parent ? firstCategory.parent.node.slug + '/' : ''}${firstCategory.slug}/` }] : []),
  { name: product.name, path: `/producto/${product.slug}/` },
];
// Precios de WooGraphQL vienen formateados ("$12.000" o "$10.000 - $20.000"): un precio o un rango.
const prices = String(product.price ?? '').split('-').map((p) => Number(p.replace(/\D/g, ''))).filter((n) => n > 0);
const availability = (product as any).stockStatus === 'OUT_OF_STOCK' ? 'https://schema.org/OutOfStock' : 'https://schema.org/InStock';
const productSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: product.name,
  description: getCardSummary(product.shortDescription ?? '', 300),
  ...(product.image?.sourceUrl ? { image: product.image.sourceUrl } : {}),
  ...((product as any).sku ? { sku: (product as any).sku } : {}),
  brand: { '@type': 'Brand', name: 'Spa Mandala' },
  ...(prices.length
    ? {
        offers: prices.length > 1
          ? { '@type': 'AggregateOffer', priceCurrency: 'CLP', lowPrice: Math.min(...prices), highPrice: Math.max(...prices), offerCount: variations.length || prices.length, availability }
          : { '@type': 'Offer', priceCurrency: 'CLP', price: prices[0], availability, url: new URL(`/producto/${product.slug}/`, Astro.url.origin).toString() },
      }
    : {}),
};
const related: SimpleProduct[] = relatedResult
  ? relatedResult.products.nodes.filter((p) => p.slug !== product.slug).slice(0, 3)
  : [];

---
<ECommerceLayout
  title={product.name}
  description={getCardSummary(product.shortDescription ?? '', 160)}
  layoutData={layoutDataPromise}
  type="product"
  image={product.image?.sourceUrl}
  breadcrumbs={breadcrumbs} breadcrumbsInBanner
  schema={[productSchema]}
>

  <div class="product-hero-shell">
  <section class="product-hero">
    {product.image?.sourceUrl && (
      <img
        src={product.image.sourceUrl}
        alt={product.image.altText || product.name}
        loading="eager"
        fetchpriority="high"
        class="absolute inset-0 w-full h-full object-cover" width="1440" height="720"
      />
    )}
    <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/45 to-black/45" />

    {badge && (
      <span class="absolute bottom-6 right-6 z-10 bg-white text-spa-charcoal text-[10px] font-bold px-3 py-1.5 rounded-full uppercase tracking-wider">
        {badge}
      </span>
    )}
    <div class="product-hero-inner max-w-6xl mx-auto flex flex-col text-white">
      <Breadcrumbs crumbs={[{ name: 'Inicio', path: '/' }, ...breadcrumbs]} inBanner inverse />
      <h1 class="product-title font-editorial">{product.name}</h1>
      <p class="text-xs text-[#F0E8DF] mb-3">{categoryName}</p>
      {tagline && (
        <p class="text-sm sm:text-base text-[#E5DFD7] font-light italic max-w-xl">{tagline}</p>
      )}
    </div>
  </section>
  </div>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="product-facts">
      {duration && (
        <div class="flex items-center gap-2 text-sm text-[#4A4036]">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-spa-taupe"><circle cx="12" cy="12" r="10" /><path d="M12 6v6l4 2" /></svg>
          <span>{duration}</span>
        </div>
      )}
      <div class="flex items-center gap-2 text-sm text-[#4A4036]">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-spa-taupe">
          <path d="M12 5a3 3 0 1 1 3 3m-3-3a3 3 0 1 0-3 3m3-3v1M9 8a3 3 0 1 0 3 3M9 8h1m5 0a3 3 0 1 1-3 3m3-3h-1m-2 3v-1" />
          <circle cx="12" cy="8" r="2" />
          <path d="M12 10v12" />
          <path d="M12 22c4.2 0 7-1.667 7-5-4.2 0-7 1.667-7 5Z" />
          <path d="M12 22c-4.2 0-7-1.667-7-5 4.2 0 7 1.667 7 5Z" />
        </svg>
        <span class="capitalize">{categoryName}</span>
      </div>
    </div>
  </div>

  <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-16">
    <div class="product-layout">
      <div class="product-purchase-column">
        <div class="product-purchase">
          <div class="product-purchase-header">
            <h2 class="product-purchase-title font-editorial">Reserva tu experiencia</h2>
            <div class="flex items-baseline gap-2.5">
              <span id="product-regular-price" class="text-sm line-through text-[#796859]" hidden={!priceInfo.original}>{priceInfo.original}</span>
              <span id="product-price" aria-live="polite" aria-atomic="true" class="product-purchase-price font-editorial">{priceInfo.current}</span>
            </div>
          </div>
          <div class="product-purchase-body space-y-5">
            {variantAttrs.length > 0 && (
              <div class="space-y-3" id="variant-picker">
                <p id="variant-guidance" class="text-sm text-[#675647]">Elige tus opciones para ver el precio final.</p>
                {variantAttrs.map((attr) => (
                  <label class="block">
                    <span class="block text-[11px] font-semibold tracking-wide uppercase text-spa-taupe mb-1.5">{attr.name}</span>
                    <select data-variant-attr={attr.name} aria-describedby="variant-guidance purchase-feedback" class="product-variant-select">
                      <option value="">Elige una opción</option>
                      {attr.options.map((o) => <option value={o}>{o}</option>)}
                    </select>
                  </label>
                ))}
              </div>
            )}
            {upsells.length > 0 && (
              <details class="product-upsells" id="upsell-block">
                <summary class="product-upsells-toggle">
                  <span>Complementa tu experiencia</span>
                  <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
                </summary>
                <div class="space-y-3">
                  {upsells.map((u) => {
                    const upsellPrice = getPriceDisplay(u.price, u.regularPrice);
                    return (
                    <div class="border-b border-dashed border-[#DDD5CA] pb-3 last:border-0 last:pb-0">
                      <label class="flex items-start gap-3 cursor-pointer">
                        <input type="checkbox" class="product-upsell-checkbox" data-upsell-id={u.databaseId} />
                        <span class="flex-1">
                          <span class="block text-sm font-semibold text-spa-charcoal leading-snug">{u.name}</span>
                          <span class="flex items-baseline gap-2">
                            {upsellPrice.original && <span class="text-xs line-through text-[#A89E95]">{upsellPrice.original}</span>}
                            <span class="text-sm font-bold text-spa-taupe-dark">{upsellPrice.current}</span>
                          </span>
                        </span>
                      </label>
                      {u.popup && (
                        <details class="mt-2 ml-7 text-xs text-[#675647] leading-relaxed">
                          <summary class="cursor-pointer text-spa-taupe underline underline-offset-2">Ver detalles</summary>
                          <p class="mt-1.5">{u.popup}</p>
                        </details>
                      )}
                    </div>
                    );
                  })}
                </div>
              </details>
            )}
            <div class="space-y-3">
              <button
                type="button"
                data-add-to-cart={product.databaseId}
                data-needs-variation={variantAttrs.length > 0 ? "1" : undefined}
                class="product-buy-button group w-full border border-[#DDD5CA] hover:border-spa-charcoal hover:bg-spa-charcoal text-spa-charcoal hover:text-white py-3.5 px-4 rounded-xl text-xs font-semibold tracking-wider uppercase flex items-center justify-center gap-2 transition-colors"
              >
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-spa-taupe group-hover:text-[#D4C3B3] transition-colors"><path d="M16 10a4 4 0 0 1-8 0" /><path d="M3.103 6.034h17.794" /><path d="M3.4 5.467a2 2 0 0 0-.4 1.2V20a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6.667a2 2 0 0 0-.4-1.2l-2-2.667A2 2 0 0 0 17 2H7a2 2 0 0 0-1.6.8z" /></svg>
                Agregar al Carrito
              </button>
              {product.giftCardEnabled !== false && (
              <button
                type="button"
                data-gift-product={product.databaseId}
                data-needs-variation={variantAttrs.length > 0 ? "1" : undefined}
                data-gift-name={product.name}
                data-gift-summary={getCardSummary(product.shortDescription ?? '', 100)}
                data-gift-image={product.image?.sourceUrl}
                data-gift-addons={upsells.length > 0 ? JSON.stringify(upsells.map((u) => ({ id: u.databaseId, name: u.name, price: formatPriceDisplay(u.price) }))) : undefined}
                class="product-gift-button group w-full bg-spa-cream hover:bg-spa-taupe text-spa-charcoal hover:text-white py-3.5 px-4 rounded-xl text-xs font-semibold tracking-wider uppercase flex items-center justify-center gap-2 transition-colors"
              >
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-spa-taupe group-hover:text-white transition-colors"><rect x="3" y="8" width="18" height="4" rx="1" /><path d="M12 8v13" /><path d="M19 12v7a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2v-7" /><path d="M7.5 8a2.5 2.5 0 0 1 0-5A4.8 8 0 0 1 12 8a4.8 8 0 0 1 4.5-5 2.5 2.5 0 0 1 0 5" /></svg>
                Regalar Gift Card
              </button>
              )}
            </div>
            <p id="purchase-feedback" class="purchase-feedback" role="status" aria-live="polite" hidden></p>
            <ul class="pt-4 border-t border-spa-cream space-y-2.5">
              <li class="flex items-center gap-2.5 text-xs text-[#675647]">
                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-spa-taupe shrink-0"><circle cx="12" cy="12" r="10" /><path d="m9 12 2 2 4-4" /></svg>
                <span>Cabinas privadas y climatizadas</span>
              </li>
              <li class="flex items-center gap-2.5 text-xs text-[#675647]">
                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-spa-taupe shrink-0"><circle cx="12" cy="12" r="10" /><path d="m9 12 2 2 4-4" /></svg>
                <span>Terapeutas certificadas</span>
              </li>
              <li class="flex items-center gap-2.5 text-xs text-[#675647]">
                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-spa-taupe shrink-0"><circle cx="12" cy="12" r="10" /><path d="m9 12 2 2 4-4" /></svg>
                <span>Productos premium</span>
              </li>
            </ul>
          </div>
        </div>
      </div>
      <div class="product-content space-y-10">
        {intro && (
          <div>
            <h2 class="product-section-title font-editorial mb-4">
              Te ofrecemos
            </h2>
            <p class="text-[#4A4036] text-sm sm:text-base leading-relaxed">{intro}</p>
          </div>
        )}

        {includes.length > 0 && (
          <div class="product-detail-section">
            <h3 class="product-section-title font-editorial mb-5 flex items-center gap-3">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-spa-taupe">
                <path d="M11.017 2.814a1 1 0 0 1 1.966 0l1.051 5.558a2 2 0 0 0 1.594 1.594l5.558 1.051a1 1 0 0 1 0 1.966l-5.558 1.051a2 2 0 0 0-1.594 1.594l-1.051 5.558a1 1 0 0 1-1.966 0l-1.051-5.558a2 2 0 0 0-1.594-1.594l-5.558-1.051a1 1 0 0 1 0-1.966l5.558-1.051a2 2 0 0 0 1.594-1.594z" />
                <path d="M20 2v4" /><path d="M22 4h-4" /><circle cx="4" cy="20" r="2" />
              </svg>
              Protocolo Incluido en la Sesión
            </h3>
            <ul class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs sm:text-sm text-[#4A4036]">
              {includes.map((item) => (
                <li class="flex items-start gap-2.5">
                  <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-spa-taupe shrink-0 mt-0.5"><circle cx="12" cy="12" r="10" /><path d="m9 12 2 2 4-4" /></svg>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>
        )}

        {benefits.length > 0 && (
          <div>
            <h3 class="product-section-title font-editorial mb-4">Beneficios Principales</h3>
            <div class="flex flex-wrap gap-2">
              {benefits.map((item) => (
                <span class="inline-flex items-center gap-1.5 text-xs bg-spa-sand text-[#4A4036] px-3.5 py-1.5 rounded-full border border-[#E2DBCE]">
                  <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-spa-taupe"><path d="M2 9.5a5.5 5.5 0 0 1 9.591-3.676.56.56 0 0 0 .818 0A5.49 5.49 0 0 1 22 9.5c0 2.29-1.5 4-3 5.5l-5.492 5.313a2 2 0 0 1-3 .019L5 15c-1.5-1.5-3-3.2-3-5.5" /></svg>
                  {item}
                </span>
              ))}
            </div>
          </div>
        )}
        {(indicatedFor.length > 0 || contraindications.length > 0) && (
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            {indicatedFor.length > 0 && (
              <div class="product-care-section">
                <h3 class="product-section-title font-editorial mb-4">Indicado para</h3>
                <ul class="space-y-2 text-xs sm:text-sm text-[#4A4036] list-disc pl-4">
                  {indicatedFor.map((item) => <li>{item}</li>)}
                </ul>
              </div>
            )}
            {contraindications.length > 0 && (
              <div class="product-care-section">
                <h3 class="product-section-title font-editorial mb-4">Contraindicaciones</h3>
                <ul class="space-y-2 text-xs sm:text-sm text-[#4A4036] list-disc pl-4">
                  {contraindications.map((item) => <li>{item}</li>)}
                </ul>
              </div>
            )}
          </div>
        )}

        {extras.map((extra) => (
          <div class="product-detail-section">
            <h3 class="product-section-title font-editorial mb-4">{extra.title}</h3>
            <div class="text-[#4A4036] text-sm leading-relaxed [&_p]:mb-2 last:[&_p]:mb-0 [&_ul]:list-disc [&_ul]:pl-5 [&_li]:mb-1 [&_strong]:text-spa-charcoal" set:html={extra.html} />
          </div>
        ))}
      </div>

    </div>

    {related.length > 0 && (
      <div class="mt-16 pt-10 border-t border-[#E5DDD2]">
        <h2 class="font-editorial text-2xl sm:text-3xl text-spa-charcoal font-normal mb-8">También te puede interesar</h2>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 sm:gap-8">
          {related.map((item) => {
            const itemBadge = getProductBadge(item.name);
            const itemPrice = getPriceDisplay(item.price, item.regularPrice);
            return (
              <a
                href={`/producto/${item.slug}`}
                class="product-related-card group text-left bg-white rounded-2xl overflow-hidden border border-[#E5DDD2] block"
              >
                <div class="relative h-44 overflow-hidden">
                  {item.image?.sourceUrl ? (
                    <img src={item.image.sourceUrl} alt={item.image.altText || item.name} width="320" height="176" loading="lazy" decoding="async" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
                  ) : (
                    <div class="w-full h-full bg-spa-sand" />
                  )}
                  {hasAnyDiscount(item.price, item.regularPrice) && (
                    <span class="absolute top-3 left-3 flex h-9 w-9 items-center justify-center rounded-full bg-white text-spa-taupe-dark shadow-sm">
        <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78L12 21.23l8.84-8.84a5.5 5.5 0 0 0 0-7.78Z" /></svg>
        <span class="sr-only">Producto con descuento</span>
      </span>
                  )}
                  {itemBadge && (
                    <span class="absolute top-3 right-3 bg-spa-charcoal text-white text-[10px] font-bold px-2 py-0.5 rounded-full tracking-wider uppercase">{itemBadge}</span>
                  )}
                </div>
                <div class="p-5">
                  <h3 class="font-editorial text-2xl text-spa-charcoal mb-2 leading-snug group-hover:text-spa-taupe transition-colors">{item.name}</h3>
                  <div class="flex items-baseline gap-2">
                    {itemPrice.original && (
                      <span class="text-xs line-through text-[#A89E95]">{itemPrice.original}</span>
                    )}
                    <span class="text-sm font-bold text-spa-taupe">{itemPrice.current}</span>
                  </div>
                </div>
              </a>
            );
          })}
        </div>
      </div>
    )}
  </section>
</ECommerceLayout>

<style>
  .product-hero-shell { padding: 12px 12px 0; }
  .product-hero { position: relative; overflow: hidden; border-radius: 20px; background: #2C2724; }
  .product-hero-inner { position: relative; min-height: 340px; padding: 20px 20px 36px; }
  .product-title { max-width: 22ch; margin: auto 0 16px; padding-top: 36px; font-size: clamp(2.5rem, 4.8vw, 4.25rem); font-weight: 400; line-height: 1.06; letter-spacing: -.025em; text-wrap: balance; overflow-wrap: anywhere; }
  .product-facts { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 28px; padding: 22px 0; border-bottom: 1px solid #DDD3C6; }
  .product-layout { display: grid; grid-template-columns: minmax(0, 1fr); gap: 36px; align-items: start; }
  .product-content, .product-purchase-column { min-width: 0; }
  .product-content { font-size: 15px; }
  .product-section-title { color: #3D3530; font-size: 1.75rem; font-weight: 500; line-height: 1.15; letter-spacing: -.015em; }
  .product-detail-section, .product-care-section { padding-top: 28px; border-top: 1px solid #DDD3C6; }
  .product-content ul { font-size: .875rem; line-height: 1.7; }
  .product-content li svg { color: #675647; }
  .product-purchase { border: 1px solid #DDD3C6; border-radius: 16px; overflow: hidden; background: #FDFBF7; }
  .product-purchase-header { padding: 24px 24px 0; color: #2C2724; }
  .product-purchase-title { margin-bottom: 14px; font-size: 1.625rem; font-weight: 500; line-height: 1.2; }
  .product-purchase-price { font-size: clamp(2.25rem, 3vw, 3rem); font-weight: 500; line-height: 1.1; letter-spacing: -.02em; }
  .product-purchase-header > div { flex-wrap: wrap; row-gap: 8px; }
  .product-purchase-body { padding: 24px; }
