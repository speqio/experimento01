  .product-upsell-checkbox { appearance: auto; flex-shrink: 0; width: 18px; height: 18px; margin-top: 2px; accent-color: #675647; }
  .product-upsells summary { display: flex; align-items: center; min-height: 44px; font-size: 13px; color: #675647; }
  .product-buy-button, .product-gift-button { min-height: 48px; border-radius: 999px; text-transform: none; letter-spacing: 0; font-size: 14px; font-weight: 600; }
