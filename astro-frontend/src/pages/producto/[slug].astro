<script type="application/json" id="variations-data" set:html={JSON.stringify(variations)} />
<script type="application/json" id="view-item-data" set:html={JSON.stringify({ id: product.databaseId, name: product.name, price: formatPriceDisplay(product.price) })} />

<script>
  import { addToCart } from '../../store/cartStore';
  import { clp, pushEcommerce } from '../../lib/dataLayer';

  const viewItem: { id: number; name: string; price: string } | null = JSON.parse(
    document.getElementById('view-item-data')?.textContent ?? 'null',
  );
  if (viewItem) {
    const price = clp(viewItem.price);
    pushEcommerce('view_item', { value: price, items: [{ item_id: String(viewItem.id), item_name: viewItem.name, price, quantity: 1, item_category: 'producto', item_category2: 'principal' }] });
  }

  const variations: { databaseId: number; price?: string; regularPrice?: string; attributes: { nodes: { name: string; value: string }[] } }[] =
    JSON.parse(document.getElementById('variations-data')?.textContent ?? '[]');
  const selects = [...document.querySelectorAll<HTMLSelectElement>('[data-variant-attr]')];
  const priceEl = document.getElementById('product-price');
  const regularEl = document.getElementById('product-regular-price');
  const initialPrice = priceEl?.textContent ?? '';
  const initialRegular = regularEl?.textContent ?? '';
  const digits = (t?: string) => Number((t ?? '').replace(/[^0-9]/g, '')) || 0;
  const actionBtns = [...document.querySelectorAll<HTMLElement>('[data-needs-variation]')];
  const feedback = document.getElementById('purchase-feedback');

  function currentVariation() {
    if (selects.some((s) => !s.value)) return null;
    return (
      variations.find((v) =>
        selects.every((s) => v.attributes.nodes.find((a) => a.name === s.dataset.variantAttr)?.value === s.value),
      ) ?? null
    );
  }

  function refresh() {
    if (feedback) feedback.hidden = true;
    selects.forEach((select) => select.removeAttribute('aria-invalid'));
    const v = currentVariation();
    actionBtns.forEach((b) => {
      if (v) b.dataset.variationId = String(v.databaseId);
      else delete b.dataset.variationId;
      b.classList.toggle('opacity-50', !v);
      b.dataset.giftVariant = selects.map((s) => s.value).filter(Boolean).join(' · ');
    });
    if (!priceEl || !regularEl) return;
    if (v?.price) {
      const clean = (t: string) => t.replace(/&nbsp;/g, ' ').replace(/<[^>]*>/g, '');
      priceEl.textContent = clean(v.price);
      const showRegular = v.regularPrice && digits(v.regularPrice) > digits(v.price);
      regularEl.textContent = showRegular ? clean(v.regularPrice ?? '') : '';
      regularEl.hidden = !showRegular;
    } else {
      priceEl.textContent = initialPrice;
      regularEl.textContent = initialRegular;
      regularEl.hidden = !initialRegular;
    }
  }
  selects.forEach((s) => s.addEventListener('change', refresh));
  refresh();

  // En fase de captura, antes que el modal de gift card: exige elegir variante.
  document.addEventListener(
    'click',
    (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLElement>('[data-needs-variation]');
      if (btn && !btn.dataset.variationId) {
        e.stopImmediatePropagation();
        e.preventDefault();
        const missing = selects.find((select) => !select.value) ?? selects[0];
        if (feedback) {
          feedback.textContent = selects.some((select) => !select.value)
            ? 'Elige las opciones del producto antes de continuar.'
            : 'Esta combinación no está disponible. Prueba con otras opciones.';
          feedback.hidden = false;
        }
        missing?.setAttribute('aria-invalid', 'true');
        missing?.focus();
      }
    },
    true,
  );

  document.querySelectorAll<HTMLButtonElement>('[data-add-to-cart]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      if (btn.disabled) return;
      btn.disabled = true;
      btn.setAttribute('aria-busy', 'true');
      const label = btn.innerHTML;
      btn.textContent = 'Agregando…';
      if (feedback) feedback.hidden = true;
      try {
      const id = Number(btn.dataset.addToCart);
      await addToCart(id, 1, btn.dataset.variationId ? Number(btn.dataset.variationId) : undefined);
      // Complementos marcados: el carrito ya tiene el principal (WordPress lo exige).
      const extras = [...document.querySelectorAll<HTMLInputElement>('[data-upsell-id]:checked')];
      for (const box of extras) {
        await addToCart(Number(box.dataset.upsellId), 1);
      }
      } catch {
        if (feedback) {
          feedback.textContent = 'No pudimos completar la acción. Revisa tu carrito antes de volver a intentarlo.';
          feedback.hidden = false;
        }
      } finally {
        btn.disabled = false;
        btn.removeAttribute('aria-busy');
        btn.innerHTML = label;
      }
    });
  });
</script>
