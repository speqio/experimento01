---
// SSR: canonical, robots y JSON-LD necesitan el dominio real de cada request.
export const prerender = false;

import PageBanner from '../components/common/PageBanner.astro';
import ECommerceLayout from '../layouts/ECommerceLayout.astro';
import { SITE_INFO } from '../lib/siteInfo';
import { businessSchema } from '../lib/seo';

// Contenido de la marca basado en spamandala.cl/sobre-nosotras/ (WordPress, modificado 05-02-2026).
// Misma URL que el sitio actual para no perder posicionamiento al migrar.
const pillars = [
  {
    title: 'Servicios con vocación',
    text: 'Creemos en las energías y en un ambiente de trabajo amigable. Cada caso es único: dedicamos tiempo a evaluarte y diseñar un masaje, una limpieza facial o una terapia especializada para tu necesidad.',
  },
  {
    title: 'Promovemos la relajación',
    text: 'Los estados de relajación mejoran la irrigación sanguínea, el drenaje linfático y la nutrición celular. También ayudan en estados de ansiedad, insomnio, déficit atencional, colon irritable, celulitis, acné y depresión.',
  },
  {
    title: 'Cuidamos nuestro entorno',
    text: 'Eliminamos nuestros desechos con cuidado, reciclamos de forma activa, usamos iluminación de bajo consumo y promovemos el uso mesurado de los recursos, para que sigan disponibles para las generaciones futuras.',
  },
];
const services = ['Masajes', 'Limpiezas faciales', 'Terapias complementarias', 'Tratamientos postoperatorios'];
const CONTACT_EMAIL = SITE_INFO.email;
const hours = [
  ...SITE_INFO.hours.map((h) => [h.label, `${h.opens} – ${h.closes} hrs`]),
  ['Domingo', 'Cerrado'],
];
const breadcrumbs = [{ name: "Sobre nosotras", path: "/sobre-nosotras/" }];
---
<ECommerceLayout title="Sobre Nosotras" schema={[businessSchema(Astro.url.origin)]} breadcrumbs={breadcrumbs} breadcrumbsInBanner description="Spa Mandala: expertas en masajes, limpiezas faciales y terapias para restablecer tu bienestar en Las Condes, Santiago.">
  <PageBanner title="Un espacio dedicado a tu bienestar" breadcrumbs={breadcrumbs} />

  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-14 sm:py-16 text-center space-y-5">
    <p class="font-editorial text-xl sm:text-2xl text-spa-charcoal leading-relaxed">
      Somos expertas en masajes y terapias. Creamos experiencias de relajación para restablecer tu biorritmo.
    </p>
    <p class="text-spa-taupe leading-relaxed">
      Tratamos las somatizaciones del estrés, tanto anímicas como tensiones musculares, y otras afecciones que afectan tu belleza y bienestar. Somos un refugio para descansar el cuerpo y la mente, rejuvenecer y recuperar energía para el día a día.
    </p>
    <ul data-stagger class="flex flex-wrap justify-center gap-2 pt-2">
      {services.map((s) => (
        <li class="bg-white border border-[#E8E2D7] rounded-full px-4 py-1.5 text-xs font-semibold tracking-wide text-spa-taupe-dark uppercase">{s}</li>
      ))}
    </ul>
  </div>

  <div class="bg-spa-cream py-14 sm:py-16 px-4 sm:px-6 lg:px-8">
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-10">
        <span class="text-xs font-semibold tracking-[0.2em] text-spa-taupe uppercase block mb-3">Experiencia Mandala</span>
        <h2 class="font-editorial text-3xl sm:text-4xl text-spa-charcoal font-normal">Lo que nos mueve</h2>
      </div>
      <div data-stagger class="grid md:grid-cols-3 gap-6">
        {pillars.map((p) => (
          <div class="bg-white rounded-2xl border border-[#E8E2D7] p-7">
            <h3 class="font-editorial text-xl text-spa-charcoal mb-3">{p.title}</h3>
            <p class="text-sm text-spa-taupe leading-relaxed">{p.text}</p>
          </div>
        ))}
      </div>
    </div>
  </div>

  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-14 sm:py-16">
    <div class="text-center mb-10">
      <span class="text-xs font-semibold tracking-[0.2em] text-spa-taupe uppercase block mb-3">Visítanos</span>
      <h2 class="font-editorial text-3xl sm:text-4xl text-spa-charcoal font-normal">Contáctanos</h2>
    </div>
    <div data-stagger class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6 text-center">
      <div>
        <p class="text-[11px] font-semibold tracking-[0.2em] text-spa-taupe uppercase mb-2">Dirección</p>
        <p class="text-spa-charcoal">Presidente Errázuriz 2933, Oficina B<br />Las Condes, Santiago</p>
      </div>
      <div>
        <p class="text-[11px] font-semibold tracking-[0.2em] text-spa-taupe uppercase mb-2">Horario</p>
        <ul class="text-spa-charcoal space-y-0.5">
          {hours.map(([d, h]) => <li>{d}: {h}</li>)}
        </ul>
      </div>
      <div>
        <p class="text-[11px] font-semibold tracking-[0.2em] text-spa-taupe uppercase mb-2">Teléfono</p>
        <a href={`https://wa.me/${SITE_INFO.whatsapp}`} target="_blank" rel="noopener" class="text-spa-charcoal underline underline-offset-4">{SITE_INFO.phone}</a>
      </div>
      <div>
        <p class="text-[11px] font-semibold tracking-[0.2em] text-spa-taupe uppercase mb-2">Correo</p>
        <a href={`mailto:${CONTACT_EMAIL}`} class="text-spa-charcoal underline underline-offset-4 break-all">{CONTACT_EMAIL}</a>
      </div>
    </div>
  </div>

  <div class="bg-spa-taupe-dark text-white py-16 px-4 sm:px-6 lg:px-8 text-center">
    <h2 class="font-editorial text-2xl sm:text-3xl font-light mb-3">¿Tienes alguna consulta o requerimiento especial?</h2>
    <p class="text-white/80 mb-8 max-w-xl mx-auto">
      Convenios corporativos, celebraciones o una experiencia a tu medida: escríbenos y lo conversamos.
    </p>
    <div class="flex flex-wrap justify-center gap-4">
      <a
        href={`https://wa.me/${SITE_INFO.whatsapp}`}
        target="_blank"
        rel="noopener"
        class="bg-white hover:bg-spa-bg text-spa-charcoal px-8 py-3.5 rounded-full text-xs font-semibold tracking-[0.18em] uppercase transition-all shadow-md"
      >
        WhatsApp
      </a>
      <a
        href="/tienda"
        class="bg-transparent border border-white/40 hover:bg-white/10 px-8 py-3.5 rounded-full text-xs font-semibold tracking-[0.18em] uppercase transition-all"
      >
        Ver servicios
      </a>
    </div>
    <p class="text-white/60 text-xs mt-8">
      <a href="/politicas-de-la-empresa" class="underline underline-offset-4">Políticas de la empresa</a>
      &nbsp;·&nbsp;
      <a href="/politicas-de-privacidad" class="underline underline-offset-4">Políticas de privacidad</a>
    </p>
  </div>
</ECommerceLayout>
