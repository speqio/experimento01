---
// SSR: canonical, robots y JSON-LD necesitan el dominio real de cada request.
export const prerender = false;

import PageBanner from '../components/common/PageBanner.astro';
import ECommerceLayout from '../layouts/ECommerceLayout.astro';
import { RESERVO_URL } from '../lib/siteInfo';
---
<ECommerceLayout title="Agenda tu hora" description="Reserva tu hora en Mándala Spa">
  <PageBanner title="Agenda tu hora" context="Reservas online" />

  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <iframe
      src={RESERVO_URL}
      title="Agenda de reservas Mándala Spa"
      loading="lazy"
      class="w-full border-0 rounded-2xl bg-white min-h-[900px]"
    ></iframe>
    <p class="text-center text-xs text-spa-taupe mt-4">
      ¿No carga el calendario?
      <a href={RESERVO_URL} target="_blank" rel="noopener" class="underline hover:text-spa-charcoal">Ábrelo en una nueva pestaña</a>.
    </p>
  </div>
</ECommerceLayout>
