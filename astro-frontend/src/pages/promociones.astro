<script>
  import { addToCart } from '../store/cartStore';
  const navigation = document.querySelector<HTMLElement>('[data-promo-navigation]');
  if (navigation) {
    const links = Array.from(navigation.querySelectorAll<HTMLAnchorElement>('a[href^="#"]'));
    const sections = links.map((link) => document.querySelector<HTMLElement>(link.getAttribute('href')!));
    const list = navigation.querySelector('ul')!;
    let selected = -1;
    let frame = 0;
    const activate = (index: number) => {
      if (selected === index) return;
      selected = index;
      links.forEach((link, i) => {
        if (i === index) link.setAttribute('aria-current', 'location');
        else link.removeAttribute('aria-current');
      });
      const link = links[index];
      if (link) list.scrollTo({ left: link.offsetLeft - list.offsetLeft - 16, behavior: 'instant' });
    };
    const updateSection = () => {
      let index = 0;
      sections.forEach((section, i) => { if (section && section.getBoundingClientRect().top <= navigation.offsetHeight + 48) index = i; });
      activate(index);
    };
    window.addEventListener('scroll', () => { cancelAnimationFrame(frame); frame = requestAnimationFrame(updateSection); }, { passive: true });
    updateSection();
  }
  // Solo los botones Happy Hour; los de la grilla los conecta ProductGrid.
  document.querySelectorAll<HTMLButtonElement>('#happy-hour [data-add-to-cart]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      if (btn.disabled) return;
      const label = btn.textContent;
      btn.disabled = true;
      btn.setAttribute('aria-busy', 'true');
      btn.textContent = 'Agregando…';
      const card = btn.closest('article')!;
      card.querySelector('.promo-action-error')?.remove();
      try {
        await addToCart(Number(btn.dataset.addToCart), 1);
      } catch {
        const error = document.createElement('p');
        error.className = 'promo-action-error';
        error.setAttribute('role', 'status');
        error.textContent = 'No pudimos completar la acción. Revisa tu carrito antes de intentarlo otra vez.';
        card.append(error);
      } finally {
        btn.disabled = false;
        btn.removeAttribute('aria-busy');
        btn.textContent = label;
      }
    });
  });
</script>
