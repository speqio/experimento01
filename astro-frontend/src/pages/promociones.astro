---
// Promociones = productos con precio rebajado (regularPrice ≠ price en
// WooCommerce). No hay categoría/campo dedicado "promoción" en producción.
export const prerender = false;

import { hasAnyDiscount } from '../lib/parse';
import ECommerceLayout from '../layouts/ECommerceLayout.astro';
import ProductGrid from '../components/catalog/ProductGrid.astro';
import { wpQuery } from '../lib/wp-graphql';
import { GET_PRODUCTS } from '../lib/queries/products';
import { GET_SITE_BANNER } from '../lib/queries/banners';
import type { SimpleProduct } from '../types/catalog';
import type { SiteBanner } from '../types/banner';

let onSale: SimpleProduct[] = [];
try {
  const data = await wpQuery<{ products: { nodes: SimpleProduct[] } }>({
    query: GET_PRODUCTS,
    variables: { first: 48 },
  });
  onSale = data.products.nodes.filter(
    (p) => hasAnyDiscount(p.price, p.regularPrice)
  );
} catch {
  // WordPress aún no configurado/disponible en build time.
}

// Banner (wp-admin → Banners → Promociones). Página SSR: los cambios se ven
// al recargar, sin esperar un deploy (a diferencia del Hero del Home).
let banner: Partial<SiteBanner> = {};
try {
  const data = await wpQuery<{ siteBanner: SiteBanner | null }>({
    query: GET_SITE_BANNER,
    variables: { key: 'promociones' },
  });
  banner = data.siteBanner ?? {};
} catch {
  // Sin WordPress — se usa el contenido de fábrica de abajo.
}

const hero = {
  eyebrow: banner.eyebrow || 'Tarifas preferenciales',
  title: banner.title || 'Promociones especiales',
  description: banner.description || 'Tratamientos con descuento por tiempo limitado en Las Condes, Santiago de Chile.',
  image: banner.image || '',
};
---
<ECommerceLayout title="Promociones">
  <div class="relative bg-spa-sand py-12 sm:py-16 px-4 sm:px-6 lg:px-8 overflow-hidden">
    {hero.image && <img src={hero.image} alt="" class="absolute inset-0 w-full h-full object-cover opacity-25" />}
    <div class="relative max-w-3xl mx-auto text-center">
      <span class="text-xs font-semibold tracking-[0.2em] text-spa-taupe uppercase block mb-3">{hero.eyebrow}</span>
      <h1 class="font-editorial text-3xl sm:text-5xl font-light text-spa-charcoal">{hero.title}</h1>
      <p class="mt-4 text-spa-taupe leading-relaxed">
        {hero.description}
      </p>
    </div>
  </div>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-14">
    {onSale.length > 0 ? (
      <ProductGrid products={onSale} basePath="/tienda" />
    ) : (
      <p class="text-sm text-spa-taupe text-center">No hay promociones activas por el momento.</p>
    )}
  </div>
</ECommerceLayout>
