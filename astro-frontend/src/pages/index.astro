<script>
  document.querySelectorAll<HTMLElement>('[data-experiences-carousel]').forEach((experiences) => {
    const track = experiences.querySelector<HTMLElement>('[data-experiences-track]')!;
    const slides = Array.from(track.children) as HTMLElement[];
    const previous = experiences.querySelector<HTMLButtonElement>('[data-experiences-prev]')!;
    const next = experiences.querySelector<HTMLButtonElement>('[data-experiences-next]')!;
    const counter = experiences.querySelector<HTMLElement>('[data-experiences-count]')!;
    const controls = experiences.querySelector<HTMLElement>('[data-experiences-controls]')!;
    const mobile = window.matchMedia('(max-width: 767px)');
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let current = 0;
    const slidePosition = (slide: HTMLElement) => slide.getBoundingClientRect().left - track.getBoundingClientRect().left + track.scrollLeft;
    const update = () => {
      controls.hidden = !mobile.matches || slides.length < 2;
      track.tabIndex = mobile.matches ? 0 : -1;
      if (!mobile.matches) return;
      current = slides.reduce((nearest, slide, index) =>
        Math.abs(slidePosition(slide) - track.scrollLeft) < Math.abs(slidePosition(slides[nearest]) - track.scrollLeft) ? index : nearest, 0);
      // The final slide aligns to the end when there is no room to align its start.
      if (track.scrollLeft > 0 && track.scrollLeft >= track.scrollWidth - track.clientWidth - 2) current = slides.length - 1;
      previous.disabled = current === 0;
      next.disabled = current === slides.length - 1;
      const label = `${current + 1} / ${slides.length}`;
      if (counter.textContent !== label) counter.textContent = label;
    };
    const goTo = (index: number) => {
      if (!mobile.matches) return;
      const target = slides[Math.max(0, Math.min(slides.length - 1, index))];
      track.scrollTo({ left: slidePosition(target), behavior: reducedMotion.matches ? 'instant' : 'smooth' });
    };
    previous.addEventListener('click', () => goTo(current - 1));
    next.addEventListener('click', () => goTo(current + 1));
    track.addEventListener('scroll', update, { passive: true });
    track.addEventListener('keydown', (event) => {
      if (event.target !== track || !mobile.matches) return;
      if (event.key === 'ArrowRight' || event.key === 'ArrowLeft') {
        event.preventDefault();
        goTo(current + (event.key === 'ArrowRight' ? 1 : -1));
      }
    });
    new ResizeObserver(update).observe(track);
    mobile.addEventListener('change', update);
    update();
  });
</script>

<script>
  // ── Hero carousel ────────────────────────────────────────────────────────────
  // Maneja el carrusel vertical del hero: avanza automáticamente, llena los
  // puntos de progreso y permite navegar manualmente con los dots o el teclado.
  const carousel = document.querySelector<HTMLElement>('[data-carousel]');
  if (carousel) {
    const slides   = Array.from(carousel.querySelectorAll<HTMLElement>('[data-slide]'));
    const dots     = Array.from(carousel.querySelectorAll<HTMLButtonElement>('[data-dot]'));
    const fills    = Array.from(carousel.querySelectorAll<HTMLElement>('[data-dot-fill]'));
    const toggle   = carousel.querySelector<HTMLButtonElement>('[data-carousel-toggle]');
    const iconPause = toggle?.querySelector<SVGElement>('[data-icon-pause]');
    const iconPlay  = toggle?.querySelector<SVGElement>('[data-icon-play]');

    const DURATION = 6000; // ms por slide
    let current = 0;
    let paused  = false;
    let raf: number | null = null;
    let startTs: number | null = null;
    let elapsed = 0;

    const FADE = 900; // ms del crossfade

    // Las diapositivas ocultas no bajan su foto al cargar la página (PageSpeed móvil): se asigna
    // al mostrarlas, y la siguiente se precarga a mitad de la actual para que el fundido no quede vacío.
    function loadSlide(index: number) {
      slides[index]?.querySelectorAll<HTMLImageElement>('img[data-src]').forEach((img) => {
        if (img.dataset.srcset) img.srcset = img.dataset.srcset;
        img.src = img.dataset.src!;
        img.removeAttribute('data-src');
        img.removeAttribute('data-srcset');
      });
    }

    function showSlide(index: number, instant = false) {
      loadSlide(index);
      const prev = current;
      const next = slides[index];
      const old  = slides[prev];

      if (instant || prev === index) {
        slides.forEach((s, i) => {
          s.style.opacity = i === index ? '1' : '0';
          s.style.transition = 'none';
          s.toggleAttribute('inert', i !== index);
          s.setAttribute('aria-hidden', i === index ? 'false' : 'true');
        });
      } else {
        // La nueva slide sube al frente y aparece; la anterior se queda atrás y se desvanece
        slides.forEach((s) => { s.style.zIndex = '0'; });
        next.style.zIndex    = '2';
        old.style.zIndex     = '1';

        next.style.transition = 'none';
        next.style.opacity    = '0';
        next.removeAttribute('inert');
        next.setAttribute('aria-hidden', 'false');

        // Un frame para que el navegador pinte opacity:0 antes de arrancar la transición
        requestAnimationFrame(() => {
          next.style.transition = `opacity ${FADE}ms cubic-bezier(0.4,0,0.2,1)`;
          next.style.opacity    = '1';
          old.style.transition  = `opacity ${FADE}ms cubic-bezier(0.4,0,0.2,1)`;
          old.style.opacity     = '0';

          setTimeout(() => {
            old.toggleAttribute('inert', true);
            old.setAttribute('aria-hidden', 'true');
            old.style.transition = 'none';
          }, FADE);
        });
      }

      dots.forEach((d, i) => {
        d.setAttribute('aria-current', i === index ? 'true' : 'false');
      });
      fills.forEach((f, i) => {
        f.style.transition = 'none';
        f.style.transform  = i < index ? 'scaleY(1)' : 'scaleY(0)';
      });
      if (instant) {
        fills[index].style.transform = 'scaleY(1)';
      }
      current = index;
    }

    function startFill() {
      if (raf) cancelAnimationFrame(raf);
      const fill = fills[current];
      if (!fill) return;
      fill.style.transition = 'none';
      fill.style.transform  = `scaleY(${elapsed / DURATION})`;

      const tick = (ts: number) => {
        if (startTs === null) startTs = ts;
        const delta = ts - startTs + elapsed;
        const progress = Math.min(delta / DURATION, 1);
        fill.style.transition = 'none';
        fill.style.transform  = `scaleY(${progress})`;
        if (progress > 0.5) loadSlide((current + 1) % slides.length);
        if (progress < 1) {
          raf = requestAnimationFrame(tick);
        } else {
          elapsed = 0;
          startTs = null;
          goTo((current + 1) % slides.length);
        }
      };
      startTs = null;
      raf = requestAnimationFrame(tick);
    }

    function goTo(index: number) {
      elapsed = 0;
      startTs = null;
      showSlide(index);
      if (!paused) startFill();
    }

    function pause() {
      paused = true;
      if (raf) { cancelAnimationFrame(raf); raf = null; }
      // Congela el progreso actual
      if (startTs !== null) elapsed += performance.now() - startTs;
      startTs = null;
      iconPause?.classList.add('hidden');
      iconPlay?.classList.remove('hidden');
      toggle?.setAttribute('aria-label', 'Reanudar el carrusel');
    }

    function resume() {
      paused = false;
      iconPause?.classList.remove('hidden');
      iconPlay?.classList.add('hidden');
      toggle?.setAttribute('aria-label', 'Pausar el carrusel');
      startFill();
    }

    // Dots manuales
    dots.forEach((dot, i) => {
      dot.addEventListener('click', () => {
        elapsed = 0; startTs = null;
        showSlide(i);
        if (!paused) startFill();
      });
    });

    // Botón pausa/play
    toggle?.addEventListener('click', () => { paused ? resume() : pause(); });

    // Teclado: ← → en el carrusel o sus controles
    carousel.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') goTo((current + 1) % slides.length);
      if (e.key === 'ArrowLeft')  goTo((current - 1 + slides.length) % slides.length);
    });

    // Pausa en hover/focus para no correr el tiempo mientras se lee
    carousel.addEventListener('mouseenter', pause);
    carousel.addEventListener('mouseleave', () => { if (!toggle?.dataset.manualPause) resume(); });
    // Pausa manual con el botón se mantiene aunque el ratón salga
    toggle?.addEventListener('click', () => { toggle.dataset.manualPause = paused ? '1' : ''; });

    // Arranca
    showSlide(0);
    // Espera a que motion.ts termine su animación de entrada (~1.5 s) antes de comenzar
    setTimeout(() => { if (!paused) startFill(); }, 1600);
  }
</script>

