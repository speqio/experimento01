---
export const prerender = true;

import ECommerceLayout from '../layouts/ECommerceLayout.astro';
import { wpQuery } from '../lib/wp-graphql';
import { GET_PRODUCTS } from '../lib/queries/products';
import { SITE_INFO } from '../lib/siteInfo';
import { getProductDuration, getProductBadge } from '../lib/parse';
import type { SimpleProduct } from '../types/catalog';

let products: SimpleProduct[] = [];
try {
  const data = await wpQuery<{ products: { nodes: SimpleProduct[] } }>({
    query: GET_PRODUCTS,
    variables: { first: 12 },
  });
  products = data.products.nodes;
} catch {
  // WordPress aún no disponible en build time — se deja vacío.
}

const featured = products.slice(0, 3);
const rituals = products.slice(3, 6);
---
<ECommerceLayout title="Mándala Spa | Bienestar & Masajes">
  <div class="space-y-16 sm:space-y-24 pb-16">
    <!-- 1. HERO -->
    <section class="relative w-full h-[480px] sm:h-[560px] lg:h-[620px] bg-spa-charcoal overflow-hidden">
      <div class="absolute inset-0 bg-gradient-to-br from-[#3a332d] to-spa-charcoal" />
      <div class="relative max-w-7xl mx-auto h-full px-6 sm:px-8 flex flex-col justify-center items-center text-center text-white">
        <span class="text-xs sm:text-sm font-semibold tracking-[0.25em] uppercase text-[#D4C3B3] mb-3">
          Un refugio de bienestar
        </span>
        <h1 class="font-editorial text-3xl sm:text-5xl lg:text-6xl font-light tracking-wide max-w-4xl leading-tight uppercase mb-4">
          Masajes, tratamientos faciales y corporales
        </h1>
        <p class="font-sans text-sm sm:text-base text-[#E5DFD7] max-w-2xl font-light leading-relaxed mb-8">
          Sesiones terapéuticas y experiencias de spa diseñadas para renovar tu cuerpo y tu calma en un ambiente sereno.
        </p>
        <div class="flex flex-col sm:flex-row items-center gap-4">
          <a
            href="/servicios"
            class="bg-transparent hover:bg-white/10 text-spa-bg border border-[#E5DFD7] px-8 py-3.5 rounded-full text-xs sm:text-sm font-semibold tracking-[0.2em] uppercase transition-all duration-300"
          >
            Ver servicios
          </a>
          <a
            href="/gift-cards"
            class="bg-[#D4C3B3] hover:bg-[#E5D7C9] text-spa-charcoal px-8 py-3.5 rounded-full text-xs sm:text-sm font-semibold tracking-[0.2em] uppercase transition-all duration-300 shadow-md"
          >
            Regalar Gift Card
          </a>
        </div>
      </div>
    </section>

    <!-- 2. CATEGORÍAS -->
    <section class="reveal max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 sm:gap-6">
        <a href="/servicios" class="group bg-spa-sand rounded-2xl overflow-hidden border border-[#E2DDD3] shadow-sm hover:shadow-md hover:-translate-y-1 transition-all duration-300 p-8 text-center">
          <span class="font-editorial text-lg tracking-[0.15em] font-medium text-spa-charcoal uppercase block">Servicios de Spa</span>
          <span class="text-xs text-spa-taupe mt-2 block">Masajes, faciales y corporales</span>
        </a>
        <a href="/tienda" class="group bg-spa-sand rounded-2xl overflow-hidden border border-[#E2DDD3] shadow-sm hover:shadow-md hover:-translate-y-1 transition-all duration-300 p-8 text-center">
          <span class="font-editorial text-lg tracking-[0.15em] font-medium text-spa-charcoal uppercase block">Tienda</span>
          <span class="text-xs text-spa-taupe mt-2 block">Productos de cuidado personal</span>
        </a>
        <a href="/gift-cards" class="group bg-spa-sand rounded-2xl overflow-hidden border border-[#E2DDD3] shadow-sm hover:shadow-md hover:-translate-y-1 transition-all duration-300 p-8 text-center">
          <span class="font-editorial text-lg tracking-[0.15em] font-medium text-spa-charcoal uppercase block">Gift Cards</span>
          <span class="text-xs text-spa-taupe mt-2 block">Regala una experiencia</span>
        </a>
      </div>
    </section>

    <!-- 3. DESTACADOS -->
    {featured.length > 0 && (
      <section class="reveal max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-8 pb-4 border-b border-[#E8E2D7]">
          <div>
            <span class="text-xs font-semibold tracking-[0.2em] text-spa-taupe uppercase block">Relajación profunda</span>
            <h2 class="font-editorial text-3xl sm:text-4xl text-spa-charcoal font-normal">Encuentra tu experiencia ideal</h2>
          </div>
          <a href="/servicios" class="mt-4 sm:mt-0 text-xs font-semibold tracking-wider uppercase text-[#6E5C4E] hover:text-spa-charcoal border border-[#DDD5CA] px-4 py-2 rounded-full hover:bg-white transition-colors">
            Ver todos
          </a>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          {featured.map((product) => {
            const duration = getProductDuration(product.attributes);
            const badge = getProductBadge(product.name);
            return (
              <div class="bg-white rounded-2xl border border-[#E8E2D7] shadow-sm hover:shadow-md hover:-translate-y-1 transition-all duration-300 overflow-hidden flex flex-col">
                <a href={`/tienda/${product.slug}`} class="relative h-56 overflow-hidden block">
                  {product.image?.sourceUrl ? (
                    <img src={product.image.sourceUrl} alt={product.image.altText ?? product.name} class="w-full h-full object-cover hover:scale-105 transition-transform duration-500" />
                  ) : (
                    <div class="w-full h-full bg-spa-sand" />
                  )}
                  {badge && (
                    <span class="absolute top-3 right-3 bg-spa-charcoal text-white text-[10px] font-bold px-2.5 py-1 rounded-full uppercase tracking-wider">
                      {badge}
                    </span>
                  )}
                </a>
                <div class="p-6 flex flex-col flex-1">
                  <h3 class="font-editorial text-xl font-semibold text-spa-charcoal mb-2 leading-snug line-clamp-2">
                    <a href={`/tienda/${product.slug}`} class="hover:text-spa-taupe transition-colors">{product.name}</a>
                  </h3>
                  <p class="text-sm text-[#6E5C4E] leading-relaxed line-clamp-3 mb-3" set:html={product.shortDescription} />
                  {duration && (
                    <div class="flex items-center gap-2 text-xs text-spa-taupe mb-4">
                      <svg viewBox="0 0 24 24" class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="9" />
                        <path d="M12 7v5l3 3" />
                      </svg>
                      <span>{duration} de duración</span>
                    </div>
                  )}

                  <div class="mt-auto pt-4 border-t border-spa-cream">
                    <div class="flex items-baseline gap-2 mb-4">
                      {product.regularPrice && product.regularPrice !== product.price && (
                        <span class="text-sm line-through text-[#A89E95]">{product.regularPrice}</span>
                      )}
                      <span class="text-lg font-bold text-spa-charcoal">{product.price}</span>
                    </div>
                    <div class="grid grid-cols-2 gap-2">
                      <button
                        type="button"
                        data-add-to-cart={product.databaseId}
                        class="bg-spa-sand hover:bg-[#E2DDD3] text-spa-charcoal py-2.5 px-2 rounded-full text-[11px] font-semibold tracking-wide uppercase transition-colors text-center"
                      >
                        Agregar al carrito
                      </button>
                      <a
                        href={`/tienda/${product.slug}`}
                        class="bg-spa-charcoal hover:bg-[#433B36] text-white py-2.5 px-2 rounded-full text-[11px] font-semibold tracking-wide uppercase transition-colors text-center"
                      >
                        Agendar hora
                      </a>
                    </div>
                  </div>
                </div>
              </div>
            );
          })}
        </div>
      </section>
    )}

    <!-- 4. CALLOUT -->
    <section class="reveal max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="bg-[#8A7968] text-white rounded-3xl p-10 sm:p-14 text-center shadow-lg relative overflow-hidden">
        <div class="absolute -top-12 -right-12 w-48 h-48 rounded-full border border-white/10" />
        <div class="absolute -bottom-12 -left-12 w-48 h-48 rounded-full border border-white/10" />
        <span class="text-xs sm:text-sm font-semibold tracking-[0.25em] uppercase text-[#E8DFD7] block mb-2">
          Hoy es un buen día para
        </span>
        <h2 class="font-editorial text-4xl sm:text-5xl font-light tracking-wide text-white mb-6">dedicarte tiempo</h2>
        <p class="text-xs sm:text-sm text-[#F0EBE4] max-w-md mx-auto mb-8 font-light leading-relaxed">
          Permite que nuestras especialistas cuiden de ti en un ambiente diseñado para desconectar de la rutina y reconectar con tu calma.
        </p>
        <a href="/servicios" class="inline-flex items-center gap-2 bg-[#E2DDD3] hover:bg-white text-spa-charcoal px-8 py-3.5 rounded-full text-xs sm:text-sm font-semibold tracking-[0.15em] uppercase transition-all duration-300 shadow-md">
          Agenda tu momento
        </a>
      </div>
    </section>

    <!-- 5. RITUALES / PRODUCTOS -->
    {rituals.length > 0 && (
      <section class="reveal max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-8 pb-4 border-b border-[#E8E2D7]">
          <div>
            <span class="text-xs font-semibold tracking-[0.2em] text-spa-taupe uppercase block">Productos especializados</span>
            <h2 class="font-editorial text-3xl sm:text-4xl text-spa-charcoal font-normal">Rituales para continuar el bienestar en casa</h2>
          </div>
          <a href="/tienda" class="mt-4 sm:mt-0 text-xs font-semibold tracking-wider uppercase text-[#6E5C4E] hover:text-spa-charcoal border border-[#DDD5CA] px-4 py-2 rounded-full hover:bg-white transition-colors">
            Ver catálogo
          </a>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          {rituals.map((product) => (
            <div class="bg-white rounded-2xl border border-[#E8E2D7] shadow-sm hover:shadow-md hover:-translate-y-1 transition-all duration-300 overflow-hidden flex flex-col justify-between">
              <a href={`/tienda/${product.slug}`} class="h-60 overflow-hidden bg-spa-cream block">
                {product.image?.sourceUrl && (
                  <img src={product.image.sourceUrl} alt={product.image.altText ?? product.name} class="w-full h-full object-cover hover:scale-105 transition-transform duration-500" />
                )}
              </a>
              <div class="p-6 pt-4">
                <h3 class="font-editorial text-xl font-semibold text-spa-charcoal mb-2">
                  <a href={`/tienda/${product.slug}`} class="hover:text-spa-taupe transition-colors">{product.name}</a>
                </h3>
                <div class="text-lg font-bold text-spa-charcoal mb-3" set:html={product.price} />
                <a href={`/tienda/${product.slug}`} class="block w-full text-center bg-spa-sand hover:bg-spa-charcoal hover:text-white text-spa-charcoal py-2.5 px-4 rounded-lg text-xs font-semibold tracking-wider uppercase transition-colors">
                  Ver producto
                </a>
              </div>
            </div>
          ))}
        </div>
      </section>
    )}

    <!-- 6. GIFT CARD BANNER -->
    <section class="reveal relative w-full bg-spa-taupe-dark text-white py-16 px-4 sm:px-6 lg:px-8 overflow-hidden">
      <div class="absolute inset-0 opacity-15 bg-[radial-gradient(#ffffff_1px,transparent_1px)] [background-size:16px_16px]" />
      <div class="relative max-w-4xl mx-auto text-center space-y-4">
        <span class="text-xs font-semibold tracking-[0.25em] uppercase text-[#D4C3B3]">Regala Bienestar</span>
        <h2 class="font-editorial text-3xl sm:text-5xl font-light">Un detalle que se transforma en una experiencia</h2>
        <p class="text-xs sm:text-sm text-[#EAE4D9] font-light max-w-xl mx-auto leading-relaxed">
          Personaliza tu Gift Card, elige el monto o el tratamiento ideal y envíala al instante.
        </p>
        <div class="pt-4">
          <a href="/gift-cards" class="inline-block bg-white hover:bg-spa-bg text-spa-charcoal px-8 py-3.5 rounded-full text-xs font-semibold tracking-[0.18em] uppercase transition-all shadow-md">
            Comprar Gift Card
          </a>
        </div>
      </div>
    </section>

    <!-- 7. UBICACIÓN -->
    <section class="reveal max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="bg-white rounded-3xl border border-[#E8E2D7] shadow-sm overflow-hidden">
        <div class="grid grid-cols-1 lg:grid-cols-12">
          <div class="lg:col-span-5 p-8 sm:p-10 flex flex-col justify-between space-y-8 bg-[#FAF8F5]">
            <div>
              <span class="text-xs font-semibold tracking-[0.2em] text-spa-taupe uppercase block mb-1">Encuéntranos</span>
              <h2 class="font-editorial text-3xl text-spa-charcoal font-medium mb-4">Ubicación &amp; Horarios</h2>
              <div class="space-y-4 text-xs sm:text-sm text-[#4A4036]">
                <p><strong class="text-spa-charcoal block">Dirección</strong>{SITE_INFO.address}</p>
                <p><strong class="text-spa-charcoal block">Horarios</strong>{SITE_INFO.schedule}</p>
                <p><strong class="text-spa-charcoal block">Contacto</strong>
                  <a href={`tel:${SITE_INFO.phone}`} class="hover:text-spa-taupe transition-colors">{SITE_INFO.phone}</a>
                </p>
              </div>
            </div>
            <div class="pt-4 border-t border-spa-sand flex flex-col sm:flex-row gap-3">
              <a href="/servicios" class="w-full bg-spa-charcoal hover:bg-[#433B36] text-white py-3 px-4 rounded-xl text-xs font-semibold tracking-wider uppercase transition-colors text-center">
                Agendar hora
              </a>
              <a
                href={`https://wa.me/${SITE_INFO.whatsapp}`}
                target="_blank"
                rel="noreferrer"
                class="w-full bg-[#25D366] hover:bg-[#20BA5A] text-white py-3 px-4 rounded-xl text-xs font-semibold tracking-wider uppercase transition-colors text-center"
              >
                WhatsApp
              </a>
            </div>
          </div>
          <div class="lg:col-span-7 h-64 lg:h-auto min-h-[280px] bg-spa-sand flex items-center justify-center text-spa-taupe text-sm">
            {SITE_INFO.address}
          </div>
        </div>
      </div>
    </section>
  </div>
</ECommerceLayout>

<script>
  import { addToCart } from '../store/cartStore';
  document.querySelectorAll<HTMLButtonElement>('[data-add-to-cart]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const id = Number(btn.dataset.addToCart);
      addToCart(id, 1);
    });
  });
</script>
