---
// SSR (no prerender): así los cambios de wp-admin (banner del Home, catálogo
// destacado, gift cards activas/inactivas) se ven al instante, sin deploy —
// mismo criterio que /tienda, /promociones y /blog.
export const prerender = false;

import ProductCard from '../components/catalog/ProductCard.astro';
import GiftCardBanner from '../components/giftcard/GiftCardBanner.astro';
import WellnessCallout from '../components/common/WellnessCallout.astro';
import Testimonials from '../components/common/Testimonials.astro';
import ECommerceLayout from '../layouts/ECommerceLayout.astro';
import { wpQuery, kvCacheFrom } from '../lib/wp-graphql';
import { fetchLayoutData } from '../lib/layoutData';
import { GET_PRODUCTS, GET_PRODUCT_IMAGES } from '../lib/queries/products';
import { groupOf, categoryGroupHref } from '../lib/categoryGroups';
import { SITE_INFO, RESERVO_URL } from '../lib/siteInfo';
import { businessSchema } from '../lib/seo';
import { GET_SITE_BANNER } from '../lib/queries/banners';
import type { SimpleProduct } from '../types/catalog';
import type { SiteBanner } from '../types/banner';

const mapsQuery = encodeURIComponent(`${SITE_INFO.streetAddress.split(',')[0]}, ${SITE_INFO.address}`);
const mapsUrl = `https://www.google.com/maps/search/?api=1&query=${mapsQuery}`;
const wazeUrl = `https://waze.com/ul?q=${mapsQuery}&navigate=yes`;
const cache = kvCacheFrom(Astro);
// Arranca YA (sin await) para que corra en paralelo con las consultas propias
// de esta página, en vez de que ECommerceLayout la dispare recién cuando le
// toque renderizar — eso sumaba los tiempos en vez de solaparlos.
const layoutDataPromise = fetchLayoutData(cache);
type ProductImage = { id: string; image: SimpleProduct['image']; productCategories: { nodes: { slug: string }[] } };
const bannerQuery = (key: string) => wpQuery<{ siteBanner: SiteBanner | null }>({ query: GET_SITE_BANNER, variables: { key }, cache });
const [productsResult, bannerResult, banner2Result, banner3Result, banner4Result, banner5Result, imagesResult, layoutResult] = await Promise.allSettled([
  wpQuery<{ products: { nodes: SimpleProduct[] } }>({ query: GET_PRODUCTS, variables: { first: 12 }, cache }),
  // Banners del carrusel del Hero (wp-admin → Marketing → Banners → Home). SSR: se ven al instante.
  // "home-2" a "home-5" aún no existen en wp-admin: mientras tanto esas diapositivas usan el contenido de fábrica.
  bannerQuery('home'),
  bannerQuery('home-2'),
  bannerQuery('home-3'),
  bannerQuery('home-4'),
  bannerQuery('home-5'),
  wpQuery<{ products: { nodes: ProductImage[] } }>({ query: GET_PRODUCT_IMAGES, cache }),
  layoutDataPromise,
]);

// WordPress aún no disponible en build time — se deja vacío.
const products: SimpleProduct[] = productsResult.status === 'fulfilled' ? productsResult.value.products.nodes : [];
const featured = products.slice(0, 3);
const rituals = products.slice(3, 6);

// Familias del menú con imágenes editoriales locales. El CMS sigue aportando categorías y enlaces.
const withImage = imagesResult.status === 'fulfilled' ? imagesResult.value.products.nodes.filter((p) => p.image?.sourceUrl) : [];
const shownBelow = new Set(featured.map((p) => p.id));
const usedImages = new Set<string>();
const serviceImages: Record<string, { file: string; altText: string; position: string }> = {
  Faciales: { file: 'faciales', altText: 'Aplicación profesional de una mascarilla facial con brocha.', position: 'center' },
  Corporales: { file: 'corporales', altText: 'Tratamiento manual de piernas en una camilla de spa.', position: 'center' },
  Masajes: { file: 'masajes', altText: 'Masaje profesional de hombros sobre una camiseta de algodón.', position: 'center' },
  'Spa Day': { file: 'spa-day', altText: 'Rincón de relajación con butaca de lino, madera clara y una taza de infusión.', position: 'center' },
};
const families = (layoutResult.status === 'fulfilled' ? layoutResult.value.categoryGroups : [])
  .filter((g) => g.label !== 'Promociones')
  .map((group) => {
    const candidates = withImage.filter(
      (p) => p.productCategories.nodes.some((c) => groupOf(c.slug) === group.label) && !usedImages.has(p.image!.sourceUrl),
    );
    const pick = candidates.find((p) => !shownBelow.has(p.id)) ?? candidates[0];
    if (pick) usedImages.add(pick.image!.sourceUrl);
    const editorial = serviceImages[group.label];
    return {
      label: group.label,
      href: categoryGroupHref(group.label),
      image: editorial ? { sourceUrl: `/images/servicios/${editorial.file}-natural-v2-960.webp`, altText: editorial.altText } : pick?.image ?? null,
      srcSet: editorial ? `/images/servicios/${editorial.file}-natural-v2-360.webp 360w, /images/servicios/${editorial.file}-natural-v2-480.webp 480w, /images/servicios/${editorial.file}-natural-v2-960.webp 960w` : undefined,
      imagePosition: editorial?.position ?? 'center',
    };
  });

// Foto de "Nuestra filosofía": otra sesión real, distinta de las de arriba y de Destacados.
const unusedImage = () => {
  const pick = withImage.find((p) => !usedImages.has(p.image!.sourceUrl) && !shownBelow.has(p.id));
  if (pick) usedImages.add(pick.image!.sourceUrl);
  return pick?.image?.sourceUrl ?? '';
};
const philosophySrc = unusedImage();
const philosophyImage = {
  ...(withImage.find((p) => p.image!.sourceUrl === philosophySrc)?.image ?? withImage[0]?.image ?? {}),
  sourceUrl: '/images/servicios/bienestar-natural-v2-960.webp',
  altText: 'Sesión de reflexología podal en Mándala Spa.',
};
const specialties = [
  { label: 'Masajes', href: categoryGroupHref('Masajes') },
  { label: 'Limpiezas faciales', href: '/tratamientos-faciales/limpieza-facial/' },
  { label: 'Terapias complementarias', href: '/tienda?q=terapia' },
  { label: 'Tratamientos postoperatorios', href: '/tienda?cat=post-operatorio' },
];

// Carrusel del Hero: cada diapositiva toma de wp-admin lo que esté cargado y completa el resto con su contenido de
// fábrica (textos que el sitio ya usa en otras secciones). Sin WordPress en build time, queda todo de fábrica.
const bannerOf = (r: typeof bannerResult): Partial<SiteBanner> => (r.status === 'fulfilled' ? (r.value.siteBanner ?? {}) : {});
type Slide = { tagline: string; title: string; description: string; image: string; primaryText: string; primaryLink: string; secondaryText: string; secondaryLink: string };
const slideFrom = (b: Partial<SiteBanner>, d: Slide): Slide => ({
  tagline: b.eyebrow || d.tagline,
  title: b.title || d.title,
  description: b.description || d.description,
  image: b.image || d.image,
  primaryText: b.primaryText || d.primaryText,
  primaryLink: b.primaryLink || d.primaryLink,
  secondaryText: b.secondaryText || d.secondaryText,
  secondaryLink: b.secondaryLink || d.secondaryLink,
});
const slides: Slide[] = [
  slideFrom(bannerOf(bannerResult), {
    tagline: 'Un refugio de bienestar',
    title: 'Masajes, tratamientos faciales y corporales',
    description: 'Sesiones terapéuticas y experiencias de spa diseñadas para renovar tu cuerpo y tu calma en un ambiente sereno.',
    image: '',
    primaryText: 'Ver servicios',
    primaryLink: '/tienda',
    secondaryText: 'Regalar Gift Card',
    secondaryLink: '/gift-cards',
  }),
  slideFrom(bannerOf(banner2Result), {
    tagline: 'Regala bienestar',
    title: 'Un detalle que se transforma en una experiencia',
    description: 'Personaliza tu Gift Card, elige el monto o el tratamiento ideal y envíala al instante.',
    image: unusedImage(),
    primaryText: 'Comprar Gift Card',
    primaryLink: '/gift-cards',
    secondaryText: 'Ver promociones',
    secondaryLink: '/promociones',
  }),
  slideFrom(bannerOf(banner3Result), {
    tagline: 'Agenda tu momento',
    title: 'Hoy es un buen día para dedicarte tiempo',
    description: 'Permite que nuestras especialistas cuiden de ti en un ambiente diseñado para desconectar de la rutina y reconectar con tu calma.',
    image: unusedImage(),
    primaryText: 'Agendar ahora',
    primaryLink: RESERVO_URL,
    secondaryText: 'Ver servicios',
    secondaryLink: '/tienda',
  }),
  slideFrom(bannerOf(banner4Result), {
    tagline: 'Tratamientos faciales',
    title: 'Tu piel merece un ritual de cuidado profesional',
    description: 'Limpiezas profundas, hidratación intensa y tratamientos anti-edad con productos de alta cosmética en manos expertas.',
    image: '/images/servicios/faciales-editorial-v1-960.webp',
    primaryText: 'Ver faciales',
    primaryLink: '/tratamientos-faciales/',
    secondaryText: 'Agendar hora',
    secondaryLink: RESERVO_URL,
  }),
  slideFrom(bannerOf(banner5Result), {
    tagline: 'Spa Day',
    title: 'Una jornada completa de descanso y renovación',
    description: 'Combina tus tratamientos favoritos en una experiencia personalizada para desconectar por completo y salir transformada.',
    image: '/images/servicios/spa-day-editorial-v1-960.webp',
    primaryText: 'Descubrir Spa Day',
    primaryLink: '/spa-day/',
    secondaryText: 'Ver promociones',
    secondaryLink: '/promociones',
  }),
];
// Fotos locales del hero: 480/720/960 para que el celular (412 px a 1,75x) no baje la de 960.
const heroSrcset = (src: string) => {
  const base = src.match(/^(\/images\/servicios\/.+)-960\.webp$/)?.[1];
  return base ? `${base}-480.webp 480w, ${base}-720.webp 720w, ${base}-960.webp 960w` : undefined;
};
const isExternal = (href: string) => /^https?:\/\//.test(href);
---
<ECommerceLayout
  title="Mándala Spa | Bienestar & Masajes"
  layoutData={layoutDataPromise}
  schema={[
    businessSchema(Astro.url.origin),
    { '@context': 'https://schema.org', '@type': 'WebSite', name: SITE_INFO.name, url: `${Astro.url.origin}/`, potentialAction: { '@type': 'SearchAction', target: `${Astro.url.origin}/tienda?q={search_term_string}`, 'query-input': 'required name=search_term_string' } },
  ]}
>
  <div class="space-y-16 sm:space-y-24 pb-16">
    <!-- 1. HERO (wp-admin → Banners → Home) -->
    <!-- Contenedor redondeado a todo el ancho disponible, con un margen lateral adaptable. Su alto es la pantalla bajo el header (≈7rem en celular,
         ≈12rem en escritorio) menos el margen de arriba y de abajo, para que el borde inferior se vea al cargar. -->
    <div class="w-full px-3 sm:px-6 lg:px-8 pt-3 sm:pt-4 lg:pt-6">
    <!-- Carrusel vertical (lib/heroCarousel.ts): la diapositiva que entra sube y cubre a la anterior. -->
    <section
      data-hero
      data-carousel
      aria-roledescription="carrusel"
      aria-label="Destacados de Mándala Spa"
      class="relative isolate w-full min-h-[520px] h-[calc(100svh-8.5rem)] sm:h-[calc(100svh-9.5rem)] lg:h-[calc(100svh-15rem)] max-h-[820px] rounded-[1.25rem] sm:rounded-[1.75rem] lg:rounded-[2.25rem] bg-spa-charcoal overflow-hidden"
    >
      {slides.map((slide, i) => {
        // Solo la primera diapositiva lleva el h1 de la página.
        const Title = i === 0 ? 'h1' : 'h2';
        return (
          <div
            data-slide
            role="group"
            aria-roledescription="diapositiva"
            aria-label={`${i + 1} de ${slides.length}`}
            aria-hidden={i === 0 ? undefined : 'true'}
            inert={i !== 0}
            class="absolute inset-0 overflow-hidden bg-spa-charcoal"
            style={`opacity:${i === 0 ? 1 : 0}; z-index:${i === 0 ? 1 : 0};`}
          >
            <div data-slide-media class="absolute inset-0">
              {slide.image ? (
                <>
                  <img
                    data-hero-media
                    src={i === 0 ? slide.image : undefined}
                    srcset={i === 0 ? heroSrcset(slide.image) : undefined}
                    data-src={i === 0 ? undefined : slide.image}
                    data-srcset={i === 0 ? undefined : heroSrcset(slide.image)}
                    sizes="100vw"
                    alt=""
                    class="absolute inset-0 w-full h-full object-cover"
                    loading={i === 0 ? 'eager' : 'lazy'}
                    fetchpriority={i === 0 ? 'high' : undefined}
                    decoding={i === 0 ? undefined : 'async'}
                  />
                  {/* En vez de un velo plano: oscurece donde va el texto y deja respirar la foto en los bordes. */}
                  <div class="absolute inset-0 bg-[radial-gradient(ellipse_95%_60%_at_50%_50%,rgba(28,24,21,0.66),rgba(28,24,21,0.34)_72%,rgba(28,24,21,0.42))] sm:bg-[radial-gradient(ellipse_62%_58%_at_50%_50%,rgba(28,24,21,0.64),rgba(28,24,21,0.26)_74%,rgba(28,24,21,0.38))]" />
                  <div class="absolute inset-x-0 bottom-0 h-2/5 bg-gradient-to-t from-[#1C1815]/55 to-transparent" />
                </>
              ) : (
                <div class="absolute inset-0 bg-gradient-to-br from-[#3a332d] to-spa-charcoal" />
              )}
            </div>
            {/* Padding lateral amplio para no chocar con los puntos de la derecha */}
            <div data-hero-content class="relative h-full px-12 sm:px-20 py-16 flex flex-col justify-center items-center text-center text-white">
              <Title data-hero-title class="font-editorial font-normal text-[2.4rem] leading-[1.05] sm:text-6xl sm:leading-[1.04] lg:text-7xl tracking-[-0.01em] max-w-4xl text-balance">
                {slide.title}
              </Title>
              {slide.tagline && (
                <p data-hero-tagline class="font-editorial italic text-xl sm:text-2xl text-[#E2D3C1] mt-4 sm:mt-5">
                  {slide.tagline}
                </p>
              )}
              <p data-hero-copy class="mt-5 max-w-xl text-[0.95rem] sm:text-base text-[#EDE6DD] leading-relaxed text-pretty">
                {slide.description}
              </p>
              <div data-hero-cta class="mt-10 flex flex-col sm:flex-row items-center gap-5 sm:gap-9">
                {slide.primaryText && (
                  <a
                    href={slide.primaryLink}
                    {...(isExternal(slide.primaryLink) ? { target: '_blank', rel: 'noopener' } : {})}
                    class="inline-flex items-center justify-center bg-[#F4EDE4] hover:bg-white text-spa-charcoal px-9 py-4 rounded-full text-xs font-semibold tracking-[0.18em] uppercase shadow-[0_12px_32px_-14px_rgba(0,0,0,0.6)] transition-colors duration-300 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#F4EDE4] focus-visible:ring-offset-4 focus-visible:ring-offset-[#2C2724]"
                  >
                    {slide.primaryText}
                  </a>
                )}
                {slide.secondaryText && (
                  <a
                    href={slide.secondaryLink}
                    {...(isExternal(slide.secondaryLink) ? { target: '_blank', rel: 'noopener' } : {})}
                    class="group inline-flex items-center gap-2.5 py-2 text-xs font-semibold tracking-[0.18em] uppercase text-[#F4EDE4] hover:text-white transition-colors duration-300 rounded-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#F4EDE4] focus-visible:ring-offset-4 focus-visible:ring-offset-[#2C2724]"
                  >
                    <span class="relative after:absolute after:inset-x-0 after:-bottom-1.5 after:h-px after:bg-current after:opacity-50 after:transition-opacity after:duration-300 group-hover:after:opacity-100">
                      {slide.secondaryText}
                    </span>
                    <svg viewBox="0 0 24 24" class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-1" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
                  </a>
                )}
              </div>
            </div>
          </div>
        );
      })}

      {/* Puntos en vertical a la derecha: el activo se alarga y se va llenando mientras corre el tiempo de la diapositiva */}
      <div data-dots class="absolute right-3 sm:right-6 lg:right-8 top-1/2 -translate-y-1/2 z-10 flex flex-col items-center gap-1">
        {slides.map((_, i) => (
          <button
            type="button"
            data-dot={i}
            aria-label={`Ir a la diapositiva ${i + 1}`}
            aria-current={i === 0 ? 'true' : undefined}
            class="group/dot flex items-center justify-center w-11 h-11 aria-[current=true]:h-12 rounded-full transition-[height] duration-500 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white/80"
          >
            <span class="relative block w-1.5 h-1.5 rounded-full overflow-hidden bg-white/45 group-hover/dot:bg-white/80 group-aria-[current=true]/dot:h-10 group-aria-[current=true]/dot:bg-white/30 transition-[height,background-color] duration-500">
              <span data-dot-fill class="absolute inset-0 bg-white origin-top scale-y-0" />
            </span>
          </button>
        ))}
        <button
          type="button"
          data-carousel-toggle
          aria-label="Pausar el carrusel"
          class="mt-3 w-11 h-11 rounded-full border border-white/40 text-white/90 flex items-center justify-center hover:bg-white/10 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white/80"
        >
          <svg data-icon-pause viewBox="0 0 24 24" class="w-3 h-3" fill="currentColor" aria-hidden="true"><rect x="6" y="5" width="4" height="14" rx="1" /><rect x="14" y="5" width="4" height="14" rx="1" /></svg>
          <svg data-icon-play viewBox="0 0 24 24" class="w-3 h-3 hidden" fill="currentColor" aria-hidden="true"><path d="M8 5.5v13a1 1 0 0 0 1.5.86l10.5-6.5a1 1 0 0 0 0-1.72L9.5 4.64A1 1 0 0 0 8 5.5Z" /></svg>
        </button>
      </div>
    </section>
    </div>

    <!-- 2. FAMILIAS DE SERVICIOS (las del menú; la foto sale de un tratamiento de cada una) -->
    {families.length > 0 && (
      <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-end justify-between gap-4 mb-10 sm:mb-12 pb-4 border-b border-[#E8E2D7]">
          <h2 class="font-editorial text-3xl sm:text-4xl text-spa-charcoal font-normal">Nuestros servicios</h2>
          <a href="/tienda" class="home-section-link">Ver todos
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6" /></svg>
          </a>
        </div>
        <ul data-stagger class={`grid grid-cols-2 gap-x-5 gap-y-10 sm:gap-x-8 ${families.length >= 4 ? 'lg:grid-cols-4' : 'sm:grid-cols-3'}`}>
          {families.map((family) => (
            <li>
              <a href={family.href} class="group block text-center focus-visible:outline-none">
                {/* Arco (mismo motivo que .arch-card) con un halo fino al pasar el mouse, como los anillos del mándala.
                    Radios en %: 40% del alto en un 4:5 = medio ancho, o sea un semicírculo exacto, sin anular las esquinas de abajo. */}
                <div class="relative isolate aspect-[4/5] rounded-[50%_50%_1rem_1rem/40%_40%_1rem_1rem] overflow-hidden bg-spa-sand ring-1 ring-transparent ring-offset-[6px] ring-offset-spa-bg transition-shadow duration-500 group-hover:ring-[#CDBFAF] group-focus-visible:ring-spa-taupe">
                  {family.image && (
                    <>
                      <img
                        src={family.image.sourceUrl}
                        srcset={family.srcSet}
                        sizes="(min-width: 1024px) 280px, (min-width: 640px) 30vw, 45vw"
                        style={{ objectPosition: family.imagePosition }}
                        alt={family.image.altText || family.label}
                        width="400"
                        height="500"
                        loading="lazy"
                        decoding="async"
                        class="w-full h-full object-cover transition-transform duration-[900ms] ease-out group-hover:scale-105"
                      />
                    </>
                  )}
                </div>
                <span class="relative inline-block mt-5 font-editorial text-xl sm:text-2xl text-spa-charcoal after:absolute after:left-0 after:right-0 after:-bottom-0.5 after:h-px after:bg-spa-taupe after:origin-center after:scale-x-0 after:transition-transform after:duration-300 after:ease-out group-hover:after:scale-x-100 group-focus-visible:after:scale-x-100">
                  {family.label}
                </span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    <!-- 2b. NUESTRA FILOSOFÍA (mismo texto que /sobre-nosotras) -->
    <section class="bg-[#F1ECE4] py-20 lg:py-28 px-4 sm:px-6 lg:px-8">
      <div class="max-w-6xl mx-auto grid lg:grid-cols-12 gap-14 lg:gap-10 items-center">
        <div data-reveal class="relative lg:col-span-5 max-w-md w-full mx-auto lg:mx-0">
          <div class="relative isolate aspect-[4/5] rounded-[1.25rem] overflow-hidden bg-spa-sand">
            {philosophyImage && (
              <>
                <img src={philosophyImage.sourceUrl} srcset="/images/servicios/bienestar-natural-v2-480.webp 480w, /images/servicios/bienestar-natural-v2-960.webp 960w" sizes="(min-width: 1024px) 440px, (min-width: 640px) 448px, 90vw" alt={philosophyImage.altText || 'Sesión en Mándala Spa'} width="480" height="600" loading="lazy" decoding="async" class="w-full h-full object-cover" />
              </>
            )}
          </div>
          {/* Sello circular: el anillo de texto gira con el scroll (data-spin) alrededor del mándala del logo */}
          <div class="absolute -bottom-8 left-4 md:bottom-auto md:left-auto md:-top-10 md:right-4 lg:-right-14 w-28 h-28 sm:w-32 sm:h-32 rounded-full bg-[#F1ECE4] text-spa-taupe-dark shadow-[0_10px_30px_-14px_rgba(44,39,36,0.45)]" aria-hidden="true">
            <svg data-spin viewBox="0 0 100 100" class="absolute inset-0 w-full h-full">
              <defs><path id="sello-filosofia" d="M 50 50 m -38 0 a 38 38 0 1 1 76 0 a 38 38 0 1 1 -76 0" /></defs>
              <text class="fill-current uppercase" style="font-size:7.4px;letter-spacing:0.18em;font-weight:600">
                <textPath href="#sello-filosofia" textLength="236" lengthAdjust="spacing">Mándala Spa · Refugio de bienestar · Las Condes ·</textPath>
              </text>
            </svg>
            <svg viewBox="0 0 100 100" class="absolute inset-[34%] stroke-current fill-none" stroke-width="3">
              <circle cx="50" cy="50" r="45" stroke-opacity="0.4" />
              <circle cx="50" cy="50" r="16" />
              <path d="M 50 18 C 42 32, 42 42, 50 50 C 58 42, 58 32, 50 18 Z" />
              <path d="M 50 82 C 42 68, 42 58, 50 50 C 58 58, 58 68, 50 82 Z" />
              <path d="M 18 50 C 32 42, 42 42, 50 50 C 42 58, 32 58, 18 50 Z" />
              <path d="M 82 50 C 68 42, 58 42, 50 50 C 58 58, 68 58, 82 50 Z" />
              <circle cx="50" cy="50" r="4" fill="currentColor" />
            </svg>
          </div>
        </div>

        <div class="lg:col-span-6 lg:col-start-7">
          <h2 class="font-editorial text-4xl lg:text-5xl font-normal leading-[1.08] text-spa-charcoal text-balance">Un espacio dedicado a tu bienestar</h2>
          <p class="mt-6 font-editorial text-xl lg:text-2xl leading-snug text-[#4A3E34] text-pretty">
            Somos expertas en masajes y terapias. Creamos experiencias de relajación para restablecer tu biorritmo.
          </p>
          <p class="mt-5 text-[0.95rem] leading-relaxed text-[#6E5C4E] max-w-[60ch] text-pretty">
            Tratamos las somatizaciones del estrés, tanto anímicas como tensiones musculares, y otras afecciones que afectan tu belleza y bienestar. Somos un refugio para descansar el cuerpo y la mente, rejuvenecer y recuperar energía para el día a día.
          </p>
          <ul data-stagger class="specialty-links mt-9">
