---
// Páginas de spamandala.cl publicadas en su misma URL (masajes, spa-day, contacto...), para no sumar redirecciones.
// El texto viene de src/data/paginas-wp.json (migracion/_herramientas/paginas_wp.py sobre el WXR);
// los productos de cada página se leen en vivo de WooCommerce según su categoría.
export const prerender = false;

import PageBanner from '../components/common/PageBanner.astro';
import ECommerceLayout from '../layouts/ECommerceLayout.astro';
import ProductGrid from '../components/catalog/ProductGrid.astro';
import ShopFilters from '../components/catalog/ShopFilters.astro';
import FaqAccordion from '../components/common/FaqAccordion.astro';
import { extractFaqSection } from '../lib/faq';
import { wpQuery, kvCacheFrom } from '../lib/wp-graphql';
import { fetchLayoutData } from '../lib/layoutData';
import { GET_PRODUCTS_BY_CATEGORIES } from '../lib/queries/products';
import { SITE_INFO } from '../lib/siteInfo';
import { wpSeo } from '../lib/seo';
import type { SimpleProduct } from '../types/catalog';
import pages from '../data/paginas-wp.json';
import posts from '../data/entradas-wp.json';

const path = (Astro.params.page ?? '').replace(/\/+$/, '');
const page = pages.find((p) => p.path === path);
if (!page) {
  // Entradas del blog con el permalink de spamandala.cl (/slug/ o /aaaa/mm/dd/slug/): se sirven sin redirigir.
  const post = path.match(/^(?:\d{4}\/\d{2}\/\d{2}\/)?([a-z0-9-]+)$/);
  if (post && posts.includes(post[1])) return Astro.rewrite(`/blog/${post[1]}`);
  return new Response(null, { status: 404 });
}

const cache = kvCacheFrom(Astro);
const layoutDataPromise = fetchLayoutData(cache);
let products: SimpleProduct[] = [];
if (page.categories.length) {
  try {
    const data = await wpQuery<{ products: { nodes: SimpleProduct[] } }>({
      query: GET_PRODUCTS_BY_CATEGORIES,
      variables: { categoryIn: page.categories, first: 48 },
      cache,
    });
    products = data.products.nodes;
  } catch {
    // Sin WordPress se muestra solo el texto.
  }
}
const { title } = page;
const segments = page.path.split('/');
const breadcrumbs = segments.map((_, i) => {
  const sub = segments.slice(0, i + 1).join('/');
  return { name: wpSeo(sub).crumb ?? pages.find((p) => p.path === sub)?.title ?? sub, path: `/${sub}/` };
});

/**
 * Limpia el HTML migrado de WP para páginas de categoría.
 * Elimina: bloque nav inicial (h2 + ul), h2 vacíos (sin p/ul siguiente),
 * secciones de gift card/regalos/interesarte, y el h2 duplicado del título.
 * Separa el bloque FAQ si existe.
 */
function cleanPageHtml(html: string, pageTitle: string): { main: string; faq: string } {
  const blockRe = /<(h[2-4]|ul|ol|p)\b[^>]*>[\s\S]*?<\/\1>/g;
  const blocks = (html.match(blockRe) ?? []).map((raw) => ({
    raw,
    tag: (raw.match(/^<(\w+)/) ?? [])[1] ?? '',
    text: raw.replace(/<[^>]+>/g, '').trim(),
  }));

  const isHeading = (t: string) => /^h[2-4]$/.test(t);
  const skip = (text: string) =>
    /pueden interesarte|ideas para regalar|giftcard y regalos|giftcard/i.test(text);

  let i = 0;

  // Saltar primer h2 si es el título de la página (duplicado)
  if (i < blocks.length && isHeading(blocks[i].tag)) {
    const norm = (s: string) => s.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '').trim();
    if (norm(blocks[i].text).includes(norm(pageTitle).slice(0, 10))) i++;
  }
  // Saltar ul de navegación que sigue al título
  if (i < blocks.length && blocks[i].tag === 'ul') i++;

  const mainBlocks: string[] = [];
  const faqBlocks: string[] = [];
  let inFaq = false;

  while (i < blocks.length) {
    const { raw, tag, text } = blocks[i];

    // Detener en secciones irrelevantes
    if (isHeading(tag) && skip(text)) break;

    // Detectar inicio de FAQ
    if (isHeading(tag) && /preguntas frecuentes/i.test(text)) {
      inFaq = true;
      i++;
      continue; // el h2 de FAQ no se muestra, solo su contenido
    }

    // Saltar h2 vacíos (sin p/ul entre este y el siguiente h2)
    if (isHeading(tag) && !inFaq) {
      const next = blocks[i + 1];
      if (!next || isHeading(next.tag)) {
        i++;
        continue;
      }
    }

    if (inFaq) faqBlocks.push(raw);
    else mainBlocks.push(raw);
    i++;
  }

  return { main: mainBlocks.join('\n'), faq: faqBlocks.join('\n') };
}

const { main: pageMain } = page.html
  ? cleanPageHtml(page.html, title)
  : { main: '', faq: '' };
const pageFaq = extractFaqSection(page.html ?? '');

// Con productos, el main (descripciones de servicio) duplica las cards y tiene
// encabezados desincronizados del WXR de origen — solo se muestra en páginas sin productos.
const showMain = !products.length;
---
<ECommerceLayout title={title} description={page.description || undefined} layoutData={layoutDataPromise} breadcrumbs={breadcrumbs} breadcrumbsInBanner>
  <PageBanner title={title} description={page.description || undefined} context="Las Condes · Santiago de Chile" breadcrumbs={breadcrumbs} class="mb-10" />

  {products.length > 0 && (
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pb-12">
      <ShopFilters products={products} />
      <ProductGrid products={products} basePath="/producto" />
    </div>
  )}

  {showMain && pageMain && (
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 pb-12">
      <article class="legal page-content min-w-0" set:html={pageMain} />
    </div>
  )}

  {pageFaq && (
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 pb-16">
      <FaqAccordion html={pageFaq} path={page.path} />
    </div>
  )}

  <div class="bg-spa-taupe-dark text-white py-14 px-4 sm:px-6 lg:px-8 text-center">
    <h2 class="font-editorial text-2xl sm:text-3xl font-light mb-6">¿Tienes dudas o quieres agendar?</h2>
    <div class="flex flex-wrap justify-center gap-4">
      <a href={`https://wa.me/${SITE_INFO.whatsapp}`} target="_blank" rel="noopener" class="bg-white hover:bg-spa-bg text-spa-charcoal px-8 py-3.5 rounded-full text-xs font-semibold tracking-[0.18em] uppercase transition-all">WhatsApp</a>
      <a href="/tienda" class="border border-white/40 hover:bg-white/10 px-8 py-3.5 rounded-full text-xs font-semibold tracking-[0.18em] uppercase transition-all">Ver servicios</a>
    </div>
  </div>
</ECommerceLayout>

<style is:global>
  /* Estilos para el contenido de páginas WP limpiado */
  .page-content h2 {
    font-family: var(--font-editorial, serif);
    font-size: 1.15rem;
    font-weight: 400;
    color: #3D3530;
    margin-top: 2rem;
    margin-bottom: .5rem;
    border-top: 0;
    padding-top: 0;
  }
  .page-content p {
    font-size: .9rem;
    line-height: 1.75;
    color: #675647;
    margin-bottom: .75rem;
  }
  .page-content ul {
    list-style: disc;
    padding-left: 1.25rem;
    margin-bottom: .75rem;
  }
  .page-content li {
    font-size: .9rem;
    color: #675647;
    line-height: 1.7;
    margin-bottom: .25rem;
  }

</style>
