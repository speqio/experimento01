---
// SSR (no prerender): necesita leer ?cat= en tiempo de request para filtrar
// por categoría real de WooCommerce (ver mega-menú del Header).
export const prerender = false;

import ECommerceLayout from '../../layouts/ECommerceLayout.astro';
import ProductGrid from '../../components/catalog/ProductGrid.astro';
import { wpQuery, kvCacheFrom } from '../../lib/wp-graphql';
import { fetchLayoutData } from '../../lib/layoutData';
import { GET_PRODUCTS, GET_PRODUCT_CATEGORIES } from '../../lib/queries/products';
import type { SimpleProduct, ProductCategory } from '../../types/catalog';

const category = Astro.url.searchParams.get('cat');
const search = Astro.url.searchParams.get('q')?.trim() || null;

const cache = kvCacheFrom(Astro);
const layoutDataPromise = fetchLayoutData(cache);
const [productsResult, catsResult] = await Promise.allSettled([
  wpQuery<{ products: { nodes: SimpleProduct[] } }>({
    query: GET_PRODUCTS,
    variables: { first: 48, category, search },
    cache,
  }),
  category
    ? wpQuery<{ productCategories: { nodes: ProductCategory[] } }>({ query: GET_PRODUCT_CATEGORIES, cache })
    : Promise.resolve(null),
]);

// WordPress aún no configurado/disponible en build time.
const products: SimpleProduct[] = productsResult.status === 'fulfilled' ? productsResult.value.products.nodes : [];
const categoryName: string | null =
  category && catsResult.status === 'fulfilled' && catsResult.value
    ? catsResult.value.productCategories.nodes.find((c) => c.slug === category)?.name ?? category
    : category;
---
<ECommerceLayout title={search ? `Tienda · ${search}` : categoryName ? `Tienda · ${categoryName}` : 'Tienda'} layoutData={layoutDataPromise}>
  <div class="bg-spa-sand py-12 sm:py-16 px-4 sm:px-6 lg:px-8 mb-10">
    <div class="max-w-6xl mx-auto text-center">
      <span class="text-xs font-semibold tracking-[0.2em] text-spa-taupe uppercase block mb-3">Las Condes · Santiago de Chile</span>
      <h1 class="font-editorial text-3xl sm:text-5xl font-light text-spa-charcoal uppercase tracking-wide">{search ? `Resultados para «${search}»` : categoryName ?? 'Tienda'}</h1>
      {(category || search) && (
        <a href="/tienda" class="inline-block mt-4 text-xs font-semibold tracking-wider uppercase text-[#6E5C4E] hover:text-spa-charcoal border border-[#DDD5CA] px-4 py-2 rounded-full hover:bg-white transition-colors">
          &larr; Ver todo el catálogo
        </a>
      )}
    </div>
  </div>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pb-16">
    {products.length > 0 ? (
      <ProductGrid products={products} basePath="/tienda" />
    ) : (
      <p class="text-sm text-spa-taupe text-center">{search ? 'No encontramos productos que coincidan con tu búsqueda.' : 'No hay productos disponibles en esta categoría por ahora.'}</p>
    )}
  </div>
</ECommerceLayout>
