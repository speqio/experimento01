---
export const prerender = true;

import ECommerceLayout from '../../layouts/ECommerceLayout.astro';
import { wpQuery } from '../../lib/wp-graphql';
import { GET_PRODUCTS, GET_PRODUCT_BY_SLUG, GET_PRODUCTS_BY_CATEGORIES } from '../../lib/queries/products';
import {
  getProductDuration,
  getProductBadge,
  extractDuration,
  parseProductSections,
  getProductTagline,
  formatPriceDisplay,
} from '../../lib/parse';
import { SITE_INFO } from '../../lib/siteInfo';
import type { SimpleProduct } from '../../types/catalog';

export async function getStaticPaths() {
  try {
    // Sin `first` explícito, GET_PRODUCTS usa su default (24) y deja fuera
    // productos del catálogo completo (~100), causando 404 en producción.
    const data = await wpQuery<{ products: { nodes: SimpleProduct[] } }>({
      query: GET_PRODUCTS,
      variables: { first: 200 },
    });
    return data.products.nodes.map((product) => ({ params: { slug: product.slug } }));
  } catch {
    return [];
  }
}

const { slug } = Astro.params;
const data = await wpQuery<{ product: SimpleProduct }>({
  query: GET_PRODUCT_BY_SLUG,
  variables: { slug },
});
const product = data.product;

const duration = getProductDuration(product.attributes) ?? extractDuration(product.shortDescription ?? '').duration;
const tagline = getProductTagline(product.shortDescription ?? '');
const categoryName = product.productCategories?.nodes?.[0]?.name ?? 'Tienda';
const categorySlug = product.productCategories?.nodes?.[0]?.slug;
const badge = getProductBadge(product.name);
const hasDiscount = Boolean(product.regularPrice && product.price && product.regularPrice !== product.price);
const { intro, benefits, includes } = parseProductSections(product.description ?? '');

let related: SimpleProduct[] = [];
if (categorySlug) {
  try {
    const relatedData = await wpQuery<{ products: { nodes: SimpleProduct[] } }>({
      query: GET_PRODUCTS_BY_CATEGORIES,
      variables: { categoryIn: [categorySlug], first: 4 },
    });
    related = relatedData.products.nodes.filter((p) => p.slug !== product.slug).slice(0, 3);
  } catch {
    // sin relacionados si falla la consulta
  }
}

---
<ECommerceLayout title={product.name} description={product.shortDescription}>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-3.5">
    <nav class="flex items-center flex-wrap gap-1.5 text-xs text-spa-taupe" aria-label="Breadcrumb">
      <a href="/" class="hover:text-spa-charcoal transition-colors">Inicio</a>
      <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6" /></svg>
      <a href="/tienda" class="hover:text-spa-charcoal transition-colors">Tienda</a>
      {categorySlug && (
        <>
          <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6" /></svg>
          <a href={`/tienda?cat=${categorySlug}`} class="hover:text-spa-charcoal transition-colors">{categoryName}</a>
        </>
      )}
      <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6" /></svg>
      <span class="text-spa-charcoal">{product.name}</span>
    </nav>
  </div>

  <section class="relative h-[26rem] sm:h-[32rem] lg:h-[36rem] w-full overflow-hidden bg-spa-charcoal">
    {product.image?.sourceUrl && (
      <img
        src={product.image.sourceUrl}
        alt={product.image.altText ?? product.name}
        class="absolute inset-0 w-full h-full object-cover scale-105"
      />
    )}
    <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/35 to-black/10" />
    <div class="absolute inset-0 bg-gradient-to-r from-black/40 via-transparent to-transparent" />
    {badge && (
      <span class="absolute top-6 right-6 bg-white text-spa-charcoal text-[10px] font-bold px-3 py-1.5 rounded-full uppercase tracking-wider">
        {badge}
      </span>
    )}
    <div class="relative h-full max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col justify-end pb-14 sm:pb-16 text-white">
      <span class="text-xs sm:text-sm font-semibold tracking-[0.25em] uppercase text-[#D4C3B3] mb-3">{categoryName}</span>
      <h1 class="font-editorial text-3xl sm:text-5xl lg:text-6xl font-medium leading-[1.05] max-w-3xl mb-2">{product.name}</h1>
      {tagline && (
        <p class="text-sm sm:text-base text-[#E5DFD7] font-light italic max-w-xl">{tagline}</p>
      )}
    </div>
  </section>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="relative -mt-8 sm:-mt-10 bg-white rounded-2xl border border-[#E8E2D7] shadow-lg px-6 sm:px-8 py-5 flex flex-wrap items-center gap-x-8 gap-y-3 justify-center sm:justify-between">
      {duration && (
        <div class="flex items-center gap-2 text-sm text-[#4A4036]">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-spa-taupe"><circle cx="12" cy="12" r="10" /><path d="M12 6v6l4 2" /></svg>
          <span>{duration}</span>
        </div>
      )}
      <div class="flex items-center gap-2 text-sm text-[#4A4036]">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-spa-taupe">
          <path d="M12 5a3 3 0 1 1 3 3m-3-3a3 3 0 1 0-3 3m3-3v1M9 8a3 3 0 1 0 3 3M9 8h1m5 0a3 3 0 1 1-3 3m3-3h-1m-2 3v-1" />
          <circle cx="12" cy="8" r="2" />
          <path d="M12 10v12" />
          <path d="M12 22c4.2 0 7-1.667 7-5-4.2 0-7 1.667-7 5Z" />
          <path d="M12 22c-4.2 0-7-1.667-7-5 4.2 0 7 1.667 7 5Z" />
        </svg>
        <span class="capitalize">{categoryName}</span>
      </div>
      <div class="hidden sm:flex items-center gap-2 text-sm text-[#4A4036]">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-spa-taupe">
          <path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z" />
          <path d="m9 12 2 2 4-4" />
        </svg>
        <span>{SITE_INFO.address}</span>
      </div>
    </div>
  </div>

  <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-16">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14">
      <div class="lg:col-span-7 space-y-10">
        <div>
          <h2 class="text-xs font-bold uppercase tracking-[0.2em] text-spa-taupe mb-3 flex items-center gap-2">
            <span class="w-6 h-px bg-spa-taupe" />Descripción Sensorial
          </h2>
          <div class="text-[#4A4036] text-sm sm:text-base leading-relaxed [&_p]:mb-3 last:[&_p]:mb-0 [&_ul]:hidden" set:html={intro} />
        </div>

        {includes.length > 0 && (
          <div class="bg-white p-6 sm:p-7 rounded-2xl border border-[#E8E2D7] shadow-sm">
            <h3 class="text-xs font-bold uppercase tracking-[0.2em] text-[#675647] mb-4 flex items-center gap-2">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-spa-taupe">
                <path d="M11.017 2.814a1 1 0 0 1 1.966 0l1.051 5.558a2 2 0 0 0 1.594 1.594l5.558 1.051a1 1 0 0 1 0 1.966l-5.558 1.051a2 2 0 0 0-1.594 1.594l-1.051 5.558a1 1 0 0 1-1.966 0l-1.051-5.558a2 2 0 0 0-1.594-1.594l-5.558-1.051a1 1 0 0 1 0-1.966l5.558-1.051a2 2 0 0 0 1.594-1.594z" />
                <path d="M20 2v4" /><path d="M22 4h-4" /><circle cx="4" cy="20" r="2" />
              </svg>
              Protocolo Incluido en la Sesión
            </h3>
            <ul class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs sm:text-sm text-[#4A4036]">
              {includes.map((item) => (
                <li class="flex items-start gap-2.5">
                  <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-spa-taupe shrink-0 mt-0.5"><circle cx="12" cy="12" r="10" /><path d="m9 12 2 2 4-4" /></svg>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>
        )}

        {benefits.length > 0 && (
          <div>
            <h3 class="text-xs font-bold uppercase tracking-[0.2em] text-[#675647] mb-4">Beneficios Principales</h3>
            <div class="flex flex-wrap gap-2">
              {benefits.map((item) => (
                <span class="inline-flex items-center gap-1.5 text-xs bg-spa-sand text-[#4A4036] px-3.5 py-1.5 rounded-full border border-[#E2DBCE]">
                  <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-spa-taupe"><path d="M2 9.5a5.5 5.5 0 0 1 9.591-3.676.56.56 0 0 0 .818 0A5.49 5.49 0 0 1 22 9.5c0 2.29-1.5 4-3 5.5l-5.492 5.313a2 2 0 0 1-3 .019L5 15c-1.5-1.5-3-3.2-3-5.5" /></svg>
                  {item}
                </span>
              ))}
            </div>
          </div>
        )}
      </div>

      <div class="lg:col-span-5">
        <div class="lg:sticky lg:top-28 bg-white rounded-3xl border border-[#E8E2D7] shadow-xl overflow-hidden">
          <div class="bg-spa-charcoal px-6 sm:px-7 py-5 text-white">
            <span class="text-[10px] font-semibold tracking-[0.25em] uppercase text-[#D4C3B3] block mb-1.5">Reserva tu experiencia</span>
            <div class="flex items-baseline gap-2.5">
              {hasDiscount && (
                <span class="text-sm line-through text-white/50">{formatPriceDisplay(product.regularPrice)}</span>
              )}
              <span class="text-3xl font-bold">{formatPriceDisplay(product.price)}</span>
            </div>
          </div>
          <div class="p-6 sm:p-7 space-y-5">
            <div class="space-y-3">
              <button
                type="button"
                data-add-to-cart={product.databaseId}
                class="w-full border border-[#DDD5CA] hover:bg-spa-bg text-spa-charcoal py-3.5 px-4 rounded-xl text-xs font-semibold tracking-wider uppercase flex items-center justify-center gap-2 transition-colors"
              >
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-spa-taupe"><path d="M16 10a4 4 0 0 1-8 0" /><path d="M3.103 6.034h17.794" /><path d="M3.4 5.467a2 2 0 0 0-.4 1.2V20a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6.667a2 2 0 0 0-.4-1.2l-2-2.667A2 2 0 0 0 17 2H7a2 2 0 0 0-1.6.8z" /></svg>
                Agregar al Carrito
              </button>
              <button
                type="button"
                data-gift-product={product.databaseId}
                data-gift-name={product.name}
                class="w-full bg-spa-cream hover:bg-[#EAE4D9] text-spa-charcoal py-3.5 px-4 rounded-xl text-xs font-semibold tracking-wider uppercase flex items-center justify-center gap-2 transition-colors"
              >
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-spa-taupe"><rect x="3" y="8" width="18" height="4" rx="1" /><path d="M12 8v13" /><path d="M19 12v7a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2v-7" /><path d="M7.5 8a2.5 2.5 0 0 1 0-5A4.8 8 0 0 1 12 8a4.8 8 0 0 1 4.5-5 2.5 2.5 0 0 1 0 5" /></svg>
                Regalar Gift Card
              </button>
            </div>
            <ul class="pt-4 border-t border-spa-cream space-y-2.5">
              <li class="flex items-center gap-2.5 text-xs text-[#675647]">
                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-spa-taupe shrink-0"><circle cx="12" cy="12" r="10" /><path d="m9 12 2 2 4-4" /></svg>
                <span>Cabinas privadas y climatizadas</span>
              </li>
              <li class="flex items-center gap-2.5 text-xs text-[#675647]">
                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-spa-taupe shrink-0"><circle cx="12" cy="12" r="10" /><path d="m9 12 2 2 4-4" /></svg>
                <span>Terapeutas certificadas</span>
              </li>
              <li class="flex items-center gap-2.5 text-xs text-[#675647]">
                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-spa-taupe shrink-0"><circle cx="12" cy="12" r="10" /><path d="m9 12 2 2 4-4" /></svg>
                <span>Productos premium</span>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </div>

    {related.length > 0 && (
      <div class="mt-16 pt-10 border-t border-[#E5DDD2]">
        <h2 class="font-editorial text-2xl sm:text-3xl text-spa-charcoal font-normal mb-8">También te puede interesar</h2>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 sm:gap-8">
          {related.map((item) => {
            const itemBadge = getProductBadge(item.name);
            const itemDiscount = Boolean(item.regularPrice && item.price && item.regularPrice !== item.price);
            return (
              <a
                href={`/tienda/${item.slug}`}
                class="group text-left bg-white rounded-2xl overflow-hidden border border-[#E5DDD2] shadow-xs hover:shadow-md hover:-translate-y-1 transition-all duration-300 block"
              >
                <div class="relative h-44 overflow-hidden">
                  {item.image?.sourceUrl ? (
                    <img src={item.image.sourceUrl} alt={item.image.altText ?? item.name} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
                  ) : (
                    <div class="w-full h-full bg-spa-sand" />
                  )}
                  {itemBadge && (
                    <span class="absolute top-3 left-3 bg-[#C94D3F] text-white text-[10px] font-bold px-2 py-0.5 rounded-full tracking-wider uppercase shadow-xs">Oferta</span>
                  )}
                </div>
                <div class="p-5">
                  <h3 class="font-editorial text-lg text-spa-charcoal mb-1.5 leading-snug group-hover:text-spa-taupe transition-colors">{item.name}</h3>
                  <div class="flex items-baseline gap-2">
                    {itemDiscount && (
                      <span class="text-xs line-through text-[#A89E95]">{formatPriceDisplay(item.regularPrice)}</span>
                    )}
                    <span class="text-sm font-bold text-spa-taupe">{formatPriceDisplay(item.price)}</span>
                  </div>
                </div>
              </a>
            );
          })}
        </div>
      </div>
    )}
  </section>
</ECommerceLayout>

<script>
  import { addToCart } from '../../store/cartStore';
  document.querySelectorAll<HTMLButtonElement>('[data-add-to-cart]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const id = Number(btn.dataset.addToCart);
      addToCart(id, 1);
    });
  });
</script>
