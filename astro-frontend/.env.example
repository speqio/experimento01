# Desarrollo local: conexión directa al WordPress de staging (cPanel),
# sin WordPress Studio. Reemplaza por la URL real del sitio de staging.
PUBLIC_WPGRAPHQL_URL=https://staging.tudominio.cl/graphql
PUBLIC_SITE_URL=http://localhost:4321

# Webpay Plus — ambiente de integración (sandbox oficial de Transbank)
WEBPAY_ENVIRONMENT=INTEGRACION
WEBPAY_COMMERCE_CODE=597055555532
WEBPAY_API_KEY=579B532A7440BB0C9079DED94D31EA1615BACEB56610332264630D42D0A36B1C

# En producción (Cloudflare Worker) estas variables se configuran con
# `wrangler secret put <NOMBRE>` — no se committean valores reales.

# Claves REST de WooCommerce (solo servidor; para marcar órdenes pagadas).
# WooCommerce → Ajustes → Avanzado → REST API → permisos Lectura/Escritura.
WC_REST_KEY=ck_xxxxxxxx
WC_REST_SECRET=cs_xxxxxxxx
